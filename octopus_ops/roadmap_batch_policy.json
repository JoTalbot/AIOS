{
  "mode": "automatic_parallel_batches",
  "max_workers": 8,
  "waves": {
    "wave_1_stability": ["autopilot_health", "timeout_audit", "orphan_process_check"],
    "wave_2_accounting": ["ledger_audit", "captcha_cost_audit", "false_entry_detection"],
    "wave_3_roi": ["source_roi_scoring", "budget_reservation", "stop_loss_validation"],
    "wave_4_integrations": ["faucet_probe", "balance_checks", "credential_gap_report"],
    "wave_5_bounties": ["multi_source_search", "live_issue_verify", "repo_trust_score"],
    "wave_6_dashboard": ["metrics_snapshot", "timer_health", "daily_summary"]
  },
  "side_effects": {
    "parallel": false,
    "require_global_lock": true,
    "require_idempotency": true,
    "require_positive_roi": true
  }
}
