[Unit]
Description=AIOS Colab Quant ML Training & Keeper (GPU)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/AIOS
Environment=DISPLAY=:1
Environment=PYTHONPATH=/root/AIOS
Environment=COLAB_SERVICE_KIND=quant_ml
Environment=COLAB_SERVICE_NAME=colab-quant-ml
ExecStart=/opt/aios/.venv/bin/python -u /root/AIOS/scripts/colab_automation_runner.py
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
