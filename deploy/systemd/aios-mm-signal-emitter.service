[Unit]
Description=AIOS MM signal emitter (trained model -> Telegram)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/AIOS
Environment=PYTHONPATH=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python -u /root/AIOS/scripts/mm_signal_emitter.py --symbols ETH BNB SOL --up-thr 0.60 --down-thr 0.40

[Install]
WantedBy=multi-user.target
