[Unit]
Description=AIOS Live On-Chain Revenue Listener - сканер реальных блокчейн-поступлений
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/AIOS
Environment=PYTHONPATH=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python -u /root/AIOS/run_live_onchain_listener.py --daemon --interval 30
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
