[Unit]
Description=AIOS Weekly Yield Sweeper and Clearing Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python /root/AIOS/run_yield_sweeper.py
StandardOutput=append:/root/AIOS/logs/yield_sweeper.log
StandardError=append:/root/AIOS/logs/yield_sweeper.log
