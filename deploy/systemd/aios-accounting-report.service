[Unit]
Description=AIOS Accounting Excel Report Generator
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python /root/AIOS/run_accounting_report.py
StandardOutput=append:/root/AIOS/logs/accounting_report.log
StandardError=append:/root/AIOS/logs/accounting_report.log
