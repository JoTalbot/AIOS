[Unit]
Description=AIOS REST API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/AIOS
EnvironmentFile=-/root/AIOS/.env
ExecStart=/usr/bin/python3 -u /root/AIOS/run_rest_api.py --host 0.0.0.0 --port 8500 --db /root/AIOS/aios.sqlite
Restart=always
RestartSec=5
StandardOutput=append:/root/AIOS/logs/api.log
StandardError=append:/root/AIOS/logs/api.log

[Install]
WantedBy=multi-user.target
