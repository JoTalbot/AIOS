def load_json(path, default=None):
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        if default and isinstance(default, dict) and isinstance(data, dict):
            for k, v in default.items():
                if k not in data:
                    data[k] = v
            return data
        return data
    except Exception:
        return default if default is not None else {}

def save_json(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2, ensure_ascii=False), encoding="utf-8")

def utc_now():
    return datetime.now(timezone.utc).isoformat()

def load_cooldowns():
    return load_json(COOLDOWN_FILE, {"cooldowns": {}})

def set_cooldown(fid, minutes=30):
    try:
        cd = load_cooldowns()
        cd.setdefault("cooldowns", {})[fid] = utc_now()
        save_json(COOLDOWN_FILE, cd)
    except Exception:
        pass

def append_ledger(coin, faucet_id, amount, status, details=""):
    try:
        ledger = load_json(LEDGER, {"claims": []})
        ledger.setdefault("claims", []).append({
            "ts": utc_now(), "faucet_id": faucet_id, "coin": coin,
            "amount": amount, "status": status, "details": details,
        })
        ledger["claims"] = ledger["claims"][-500:]
        save_json(LEDGER, ledger)
    except Exception:
        pass

# ─── 2Captcha solver ────────────────────────────────────

def solve_captcha_2captcha(api_key, sitekey, page_url, captcha_type="userrecaptcha"):
    """Solve reCAPTCHA/Turnstile via 2Captcha."""
    method = "userrecaptcha"
    if captcha_type == "hcaptcha":
        method = "hcaptcha"

    submit_data = urllib.parse.urlencode({
        "key": api_key, "method": method,
        "googlekey": sitekey, "pageurl": page_url,
        "json": 1, "invisible": 1,
    }).encode()

    try:
        req = urllib.request.Request("https://api.2captcha.com/in.php", data=submit_data)
        with urllib.request.urlopen(req, timeout=15) as resp:
            result = json.loads(resp.read().decode())
        if result.get("status") != 1:
            log.warning(f"2Captcha submit failed: {result}")
            return None
        task_id = result["request"]
        log.info(f"  2Captcha task {task_id} submitted ({captcha_type})...")
    except Exception as e:
        log.error(f"  2Captcha submit error: {e}")
        return None

    for _ in range(30):
        time.sleep(5)
        try:
            poll = f"https://api.2captcha.com/res.php?key={api_key}&action=get&id={task_id}&json=1"
            with urllib.request.urlopen(poll, timeout=15) as resp:
                result = json.loads(resp.read().decode())
            if result.get("status") == 1:
                log.info(f"  2Captcha SOLVED! token len={len(result['request'])}")
                return result["request"]
            if result.get("request") != "CAPCHA_NOT_READY":
                log.warning(f"  2Captcha error: {result}")
                return None
        except Exception as e:
            log.error(f"  2Captcha poll error: {e}")
    log.warning("  2Captcha timeout 150s")
    return None

# ─── Core: claim one faucet with Playwright ─────────────

def claim_faucet(faucet_id: str, fdef: Dict, api_key: str = "",
                 extra_address: str = "", headless: bool = True, probe_only: bool = False) -> Dict:
    """Full Playwright claim flow for one faucet."""
    url = fdef["url"]
    coin = fdef.get("coin", "UNKNOWN")
    expected_captcha = fdef.get("captcha_type", "unknown")

    result = {
        "faucet_id": faucet_id, "coin": coin, "url": url,
        "status": "unknown", "amount": "0", "message": "",
        "captcha_type": "none", "sitekey": "",
        "forms": [], "page_title": "", "timestamp": utc_now(),
    }

    browser = None
    try:
        with sync_playwright() as p:
            browser = p.chromium.launch(
                headless=headless,
                args=["--no-sandbox", "--disable-blink-features=AutomationControlled", "--disable-dev-shm-usage"],
            )
            ctx = browser.new_context(
                user_agent="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36",
                viewport={"width": 1920, "height": 1080},
            )
            page = ctx.new_page()

            log.info(f"[{coin}] Loading {url}...")
            page.goto(url, wait_until="networkidle", timeout=90000)
            time.sleep(3)
            # Extra wait for JS-rendered content
            try:
                page.wait_for_load_state("networkidle", timeout=30000)
            except:
                pass
            html = page.content()
            result["page_title"] = page.title()

            # ── Detect captcha ──
            captcha_type = "none"
            sitekey = ""

            # Turnstile
            if "turnstile" in html.lower() or "cf-turnstile" in html:
                captcha_type = "turnstile"
                for pat in [r'data-sitekey=["\']([\w-]{20,})["\']', r'sitekey["\s:=]+["\']([\w-]{20,})["\']']:
                    m = re.search(pat, html)
                    if m:
                        sitekey = m.group(1)
                        break

            # reCAPTCHA
            if not sitekey and ("g-recaptcha" in html or "recaptcha" in html.lower()):
                captcha_type = "recaptcha"
                m = re.search(r'data-sitekey=["\']([\w-]{20,})["\']', html)
                if m and len(m.group(1)) >= 20 and not m.group(1).startswith("cc-"):
                    sitekey = m.group(1)
                else:
                    captcha_type = "none"

            # hCaptcha
            if not sitekey and "hcaptcha" in html.lower():
                captcha_type = "hcaptcha"
                m = re.search(r'data-sitekey=["\']([\w-]{20,})["\']', html)
                if m:
                    sitekey = m.group(1)

            result["captcha_type"] = captcha_type
            result["sitekey"] = sitekey
            log.info(f"[{coin}] Captcha: {captcha_type} key={'YES' if sitekey else 'NO'}")

            # ── Solve captcha ──
            if (not probe_only) and sitekey and api_key and captcha_type in ("recaptcha", "turnstile", "hcaptcha"):
                token = solve_captcha_2captcha(api_key, sitekey, url, captcha_type)
                if token:
                    log.info(f"[{coin}] Injecting {captcha_type} token...")
                    try:
                        if captcha_type == "recaptcha":
                            page.evaluate('''(t) => {
                                let ta = document.querySelector('textarea[name="g-recaptcha-response"]');
                                if (ta) ta.value = t;
                            }''', token)
                        elif captcha_type == "turnstile":
                            page.evaluate('''(t) => {
                                let el = document.querySelector('input[name="cf-turnstile-response"]');
                                if (el) el.value = t;
                                document.querySelectorAll('[data-turnstile-response]').forEach(e => e.setAttribute('data-turnstile-response', t));
                            }''', token)
                        elif captcha_type == "hcaptcha":
                            page.evaluate('''(t) => {
                                let ta = document.querySelector('textarea[name="h-captcha-response"]');
                                if (ta) ta.value = t;
                            }''', token)
                        time.sleep(1)
                    except Exception as e:
                        log.warning(f"[{coin}] Token injection error: {e}")

            # ── Fill address ──
            cfg = load_json(FAUCET_CFG, {})
            address = extra_address or fdef.get("address", "")
            if not address and fdef.get("address_config_key"):
                address = cfg.get(fdef["address_config_key"], "")
            if fdef.get("address_config_key") and not address:
                result["status"] = "missing_credentials"
                result["message"] = f"Missing config key: {fdef['address_config_key']}"
                log.warning(f"[{coin}] {result['message']}")
                return result
            if address:
                addr_selectors = fdef.get("address_field", "input[name='address']").split(", ")
                for sel in addr_selectors:
                    try:
                        el = page.query_selector(sel.strip())
                        if el and el.is_visible():
                            el.fill(address)
                            log.info(f"[{coin}] Address filled via {sel.strip()}")
                            break
                    except Exception:
                        continue

            # ── Collect forms ──
            try:
                forms = page.evaluate('''() => {
                    return Array.from(document.querySelectorAll('form')).map((f, i) => ({
                        idx: i, action: f.action || '', method: (f.method || '').toUpperCase(),
                        inputs: Array.from(f.querySelectorAll('input, textarea, select, button')).map(el => ({
                            tag: el.tagName, type: el.type || '', name: el.name || '',
                            id: el.id || '', placeholder: (el.placeholder || '').substring(0, 60),
                            visible: el.offsetParent !== null, btn_text: (el.value || el.textContent || '').substring(0, 50),
                        }))
                    }));
                }''')
                result["forms"] = forms
                log.info(f"[{coin}] {len(forms)} form(s) found")
                for fi, form in enumerate(forms):
                    vis_inputs = [i for i in form["inputs"] if i["visible"]]
                    log.info(f"  Form {fi}: {form['method']} {form['action'][:60]} | {len(vis_inputs)} visible inputs")
                    for inp in vis_inputs:
                        log.info(f"    {inp['tag']} name='{inp['name']}' type='{inp['type']}' placeholder='{inp['placeholder']}' text='{inp['btn_text']}'")
            except Exception as e:
                log.warning(f"[{coin}] Form extraction error: {e}")

            if probe_only:
                result["status"] = "probed"
                result["message"] = f"captcha={captcha_type}; forms={len(result.get('forms', []))}"
                return result

            # ── Find and click claim/submit button ──
            clicked = False
            btn_selectors = (fdef.get("claim_button", "") + ", button[type='submit'], input[type='submit']").split(", ")
            for sel in btn_selectors:
                sel = sel.strip()
                if not sel:
                    continue
                try:
                    el = page.query_selector(sel)
                    if el and el.is_visible():
                        txt = (el.inner_text() or el.get_attribute("value") or "")[:60]
                        log.info(f"[{coin}] Clicking '{txt}' via {sel}")
                        el.click()
                        clicked = True
                        break
                except Exception:
                    continue

            if not clicked:
                try:
                    page.evaluate('''() => {
                        const b = document.querySelector('button[type="submit"], input[type="submit"], form button');
                        if (b) b.click();
                    }''')
                    clicked = True
                    log.info(f"[{coin}] JS fallback click")
                except Exception:
                    pass

            # ── Analyze result ──
            if clicked:
                time.sleep(5)
                try:
                    page.wait_for_load_state("networkidle", timeout=10000)
                except Exception:
                    pass

                post_html = page.content()
                post_title = page.title()

                # Save for debugging
                try:
                    with open(f"/tmp/pw_{faucet_id}_{int(time.time())}.html", "w") as f:
                        f.write(post_html)
                    page.screenshot(path=f"/tmp/pw_{faucet_id}_{int(time.time())}.png", full_page=True)
                except Exception:
                    pass

                combined = post_html.lower()

                # Check for navigation to success page
                if post_title != result["page_title"]:
                    log.info(f"[{coin}] Page changed: '{result['page_title']}' -> '{post_title}'")

                # Success/error detection
                skw = fdef.get("success_keywords", ["success", "sent", "claimed"])
                ekw = fdef.get("error_keywords", ["error", "wait", "invalid", "rate limit", "already"])

                if any(k in combined for k in skw):
                    # Try to extract amount or tx hash
                    amount = ""
                    tx = ""
                    amt_m = re.search(r'(\d+\.?\d*)\s*(POL|BNB|DASH|BTC|DOGE|ETH|sats?)', post_html, re.IGNORECASE)
                    if amt_m:
                        amount = f"{amt_m.group(1)} {amt_m.group(2)}"
                    tx_m = re.search(r'0x[a-fA-F0-9]{40,64}', post_html)
                    if tx_m:
                        tx = tx_m.group(0)[:20] + "..."

                    result["status"] = "claimed"
                    result["amount"] = amount or "check"
                    result["message"] = f"tx={tx}" if tx else "Success detected"
                    log.info(f"[{coin}] CLAIMED! {result['message']} {amount}")

                elif any(k in combined for k in ekw):
                    msg = ""
                    for k in ekw:
                        idx = combined.find(k)
                        if idx >= 0:
                            msg = post_html[max(0,idx-20):idx+80].strip()
                            break
                    result["status"] = "error"
                    result["message"] = msg[:100]
                    log.warning(f"[{coin}] Error: {msg[:100]}")
                else:
                    result["status"] = "clicked_unknown"
                    result["message"] = f"Page: '{post_title}' — check HTML"
                    log.info(f"[{coin}] Clicked, unclear result. Title: '{post_title}'")
            else:
                result["status"] = "no_button"
                result["message"] = "No submit button"
                log.warning(f"[{coin}] No submit button found")

            # ── Get all visible text for analysis ──
            try:
                body_text = page.evaluate("() => document.body.innerText.substring(0, 2000)")
                result["body_text"] = body_text
            except Exception:
                pass

            browser.close()
            browser = None

    except PlaywrightTimeout:
        result["status"] = "timeout"
        result["message"] = "Page timeout"
    except Exception as e:
        result["status"] = "exception"
        result["message"] = str(e)[:200]
        log.error(f"[{coin}] Exception: {e}")
    finally:
        try:
            if browser:
                browser.close()
        except Exception:
            pass

    set_cooldown(faucet_id)
    append_ledger(coin, faucet_id, result.get("amount", "0"), result["status"], result.get("message", ""))
    return result


def main():
    parser = argparse.ArgumentParser(description="Universal Playwright Faucet Claimer")
    parser.add_argument("--faucets", type=str, default=None, help="Comma-separated faucet IDs")
    parser.add_argument("--all-direct", action="store_true", help="Claim all direct/submittable faucets")
    parser.add_argument("--loop", action="store_true", help="Loop mode")
    parser.add_argument("--interval", type=int, default=300, help="Loop interval (s)")
    parser.add_argument("--headed", action="store_true", help="Visible browser")
    parser.add_argument("--address", type=str, default="", help="Override wallet address")
    parser.add_argument("--api-key", type=str, default=None, help="2Captcha API key")
    parser.add_argument("--probe-only", action="store_true", help="Inspect forms/captcha without solving or submitting")
    args = parser.parse_args()

    # Load API key
    api_key = args.api_key
    if not api_key:
        cfg = load_json(FAUCET_CFG, {})
        api_key = cfg.get("captcha", {}).get("2captcha", {}).get("api_key", "")

    # Determine which faucets to run
    faucet_ids = []
    if args.faucets:
        faucet_ids = [f.strip() for f in args.faucets.split(",")]
    elif args.all_direct:
        faucet_ids = list(FAUCET_DEFS.keys())
    else:
        faucet_ids = ["stakely-polygon", "dash-faucet-com", "cryptofaucet-club"]

    iteration = 0
    while True:
        iteration += 1
        log.info(f"{'='*60} ITERATION #{iteration} | {len(faucet_ids)} faucets {'='*60}")

        results = []
        for fid in faucet_ids:
            if fid not in FAUCET_DEFS:
                log.warning(f"Unknown faucet: {fid}")
                continue
            fdef = FAUCET_DEFS[fid].copy()
            if args.address:
                fdef["address"] = args.address

            log.info(f"\n{'─'*50} {fid} ({fdef['coin']}) {'─'*50}")
            r = claim_faucet(fid, fdef, api_key=api_key, extra_address=args.address, headless=not args.headed, probe_only=args.probe_only)
            results.append(r)
            if fid != faucet_ids[-1]:
                time.sleep(5)

        # Print summary
        print(f"\n{'='*75}")
        print(f"PLAYWRIGHT FAUCET RESULTS — Iteration #{iteration}")
        print(f"{'='*75}")
        print(f"{'FAUCET':<25} {'COIN':<6} {'STATUS':<20} {'AMOUNT':<16} {'MESSAGE'}")
        print("-"*75)
        claimed = 0
        for r in results:
            if r["status"] == "claimed":
                claimed += 1
            msg = (r.get("message", ""))[:30]
            print(f"{r['faucet_id']:<25} {r['coin']:<6} {r['status']:<20} {r.get('amount','0'):<16} {msg}")
        print("-"*75)
        print(f"Total: {len(results)} | Claimed: {claimed} | Other: {len(results)-claimed}")
        print(f"{'='*75}\n")

        if not args.loop:
            break
        log.info(f"Sleeping {args.interval}s...")
        time.sleep(args.interval)


if __name__ == "__main__":
    main()
