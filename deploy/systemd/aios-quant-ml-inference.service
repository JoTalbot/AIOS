[Unit]
Description=AIOS Quant ML Engine - Inference Daemon
After=network.target aios-market-data.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/AIOS
Environment=PYTHONPATH=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python -u /root/AIOS/run_quant_ml_inference.py --daemon --interval 600
Restart=always
RestartSec=20
MemoryMax=1024M

[Install]
WantedBy=multi-user.target
