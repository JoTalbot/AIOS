[Unit]
Description=AIOS deal scanner (cheap VAZ/GAZel lots)
After=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python /root/AIOS/run_deal_scanner.py
StandardOutput=append:/root/AIOS/logs/deal_scanner.log
StandardError=append:/root/AIOS/logs/deal_scanner.log
