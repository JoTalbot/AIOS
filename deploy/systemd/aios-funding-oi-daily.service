[Unit]
Description=AIOS daily funding/OI history collector (Binance Futures)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/AIOS
Environment=PYTHONPATH=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python -u /root/AIOS/scripts/collect_funding_oi_daily.py

[Install]
WantedBy=multi-user.target
