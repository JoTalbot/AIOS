{
  "title": "AIOS Autocoder",
  "uid": "aios-autocoder",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": ["aios", "autocoder"],
  "description": "AIOS auto-coder & orchestrator activity",
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "title": "Cycle rate per day",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{"expr": "aios_cycle_rate_per_day", "refId": "A"}],
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "title": "Production cycles total",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{"expr": "aios_production_cycles_total", "refId": "A"}],
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "title": "Cycle rate per hour",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{"expr": "aios_cycle_rate_per_hour", "refId": "A"}],
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "title": "Constitution articles",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{"expr": "aios_constitution_articles", "refId": "A"}],
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "title": "Cycle rate trend (last 1h)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{"expr": "aios_cycle_rate_per_hour", "refId": "A", "legendFormat": "cycles/hour"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "fieldConfig": {"defaults": {}, "overrides": []}
    },
    {
      "title": "Cards collected by platform",
      "type": "bargauge",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{"expr": "aios_cards_collected_total", "refId": "A", "legendFormat": "{{platform}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    }
  ]
}
