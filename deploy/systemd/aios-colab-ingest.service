[Unit]
Description=AIOS Colab Ingest Server (приём моделей из Colab -> автозагрузка на Google Диск)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python /root/AIOS/colab_ingest_server.py --port 8123 --dir /root/AIOS/data/quant/models --gdrive-folder AIOS_colab_models
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
