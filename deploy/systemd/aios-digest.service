[Unit]
Description=AIOS Daily Digest (Telegram)
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python /root/AIOS/run_digest.py
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/aios/aios-telegram-bot.env
StandardOutput=append:/root/AIOS/logs/digest.log
StandardError=append:/root/AIOS/logs/digest.log
