#!/usr/bin/env python3
"""claimclicks_playwright.py v2 — Playwright-based ClaimClicks faucet claimer.

ClaimClicks краны (BTC, DOGE, LTC, BCH, DASH, TRX):
  - FaucetPay payouts, без регистрации
  - Turnstile/reCAPTCHA в JS (нужен браузер)
  - Каждый клейм 1-3 мин cooldown

Использование:
  python3 claimclicks_playwright.py                    # все 6 кранов
  python3 claimclicks_playwright.py --coins btc,doge   # только btc и doge
  python3 claimclicks_playwright.py --loop --interval 180  # цикл каждые 3 мин
  python3 claimclicks_playwright.py --one-shot          # один клейм и выход
"""

