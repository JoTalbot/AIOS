[Unit]
Description=AIOS SelfGuard - watchdog критичных файлов (защита от самоповреждения автокодера)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python -u /root/AIOS/scripts/selfguard.py
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/root
Environment=PYTHONPATH=/root/AIOS
EnvironmentFile=/etc/aios/aios-auto-coder.env
StandardOutput=append:/root/AIOS/logs/selfguard.log
StandardError=append:/root/AIOS/logs/selfguard.log

[Install]
WantedBy=multi-user.target
