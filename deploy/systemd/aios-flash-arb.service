[Unit]
Description=AIOS Flash-Loan Arbitrage Scanner v20 - cross-DEX/CEX scan + TG alerts on viable windows
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/AIOS
Environment=PYTHONPATH=/root/AIOS
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/aios/.venv/bin/python -u /root/AIOS/run_dex_arbitrage_scanner.py --daemon --interval 300 --min-spread 0.8
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
