# ─── Helpers ─────────────────────────────────────────────

def load_json(path: Path, default: Any = None) -> Any:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        if default is not None and isinstance(default, dict):
            if not isinstance(data, dict):
                return default
            for k, v in default.items():
                if k not in data:
                    data[k] = v
            return data
        return data
    except Exception:
        return default if default is not None else {}

def save_json(path: Path, data: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2, ensure_ascii=False), encoding="utf-8")

def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat()

def load_cooldowns() -> Dict[str, Any]:
    return load_json(COOLDOWN_FILE, {"cooldowns": {}})

def save_cooldowns(cd: Dict[str, Any]) -> None:
    save_json(COOLDOWN_FILE, cd)

def is_on_cooldown(fid: str, min_interval_min: int = 3) -> bool:
    cd = load_cooldowns()
    last = cd.get("cooldowns", {}).get(fid)
    if not last:
        return False
    try:
        elapsed = (datetime.now(timezone.utc) - datetime.fromisoformat(last)).total_seconds() / 60
    except (ValueError, TypeError):
        return False
    return elapsed < min_interval_min

def set_cooldown(fid: str) -> None:
    try:
        cd = load_cooldowns()
        if "cooldowns" not in cd:
            cd["cooldowns"] = {}
        cd["cooldowns"][fid] = utc_now()
        save_cooldowns(cd)
    except Exception as e:
        log.warning(f"Cooldown save failed: {e}")

def append_ledger(coin: str, faucet_id: str, amount: str, status: str, details: str = ""):
    try:
        ledger = load_json(LEDGER, {"claims": []})
        if "claims" not in ledger:
            ledger["claims"] = []
        entry = {
            "ts": utc_now(),
            "faucet_id": faucet_id,
            "coin": coin,
            "amount": amount,
            "status": status,
            "details": details,
        }
        ledger["claims"].append(entry)
        ledger["claims"] = ledger["claims"][-500:]
        save_json(LEDGER, ledger)
    except Exception as e:
        log.warning(f"Ledger append failed: {e}")

# ─── 2Captcha solver ────────────────────────────────────

def solve_recaptcha_2captcha(api_key: str, sitekey: str, page_url: str) -> Optional[str]:
    """Solve reCAPTCHA v2/v3 or Turnstile via 2Captcha API."""
    import urllib.request
    import urllib.parse

    submit_data = urllib.parse.urlencode({
        "key": api_key,
        "method": "userrecaptcha",
        "googlekey": sitekey,
        "pageurl": page_url,
        "json": 1,
        "invisible": 1,
    }).encode()

    try:
        req = urllib.request.Request("https://api.2captcha.com/in.php", data=submit_data)
        with urllib.request.urlopen(req, timeout=15) as resp:
            result = json.loads(resp.read().decode())
        if result.get("status") != 1:
            log.warning(f"2Captcha submit failed: {result}")
            return None
        task_id = result["request"]
        log.info(f"2Captcha task submitted: {task_id}, waiting...")
    except Exception as e:
        log.error(f"2Captcha submit error: {e}")
        return None

    for i in range(30):
        time.sleep(5)
        try:
            poll_url = f"https://api.2captcha.com/res.php?key={api_key}&action=get&id={task_id}&json=1"
            with urllib.request.urlopen(poll_url, timeout=15) as resp:
                result = json.loads(resp.read().decode())
            if result.get("status") == 1:
                token = result["request"]
                log.info(f"2Captcha solved! token len={len(token)}")
                return token
            if result.get("request") != "CAPCHA_NOT_READY":
                log.warning(f"2Captcha error: {result}")
                return None
        except Exception as e:
            log.error(f"2Captcha poll error: {e}")

    log.warning("2Captcha timeout after 150s")
    return None

# ─── Core: claim one faucet ──────────────────────────────

def claim_one_faucet(
    coin: str,
    url: str,
    api_key: str = "",
    wallet_address: str = "",
    headless: bool = True,
    timeout_sec: int = 60,
) -> Dict[str, Any]:
    """Зайти на ClaimClicks кран, решить капчу, получить клейм."""
    fid = f"claimclicks-{coin}"
    result = {
        "faucet_id": fid,
        "coin": coin,
        "url": url,
        "status": "unknown",
        "amount": "0",
        "message": "",
        "captcha_type": "none",
        "sitekey": "",
        "forms": [],
        "hidden_captcha_inputs": [],
        "timestamp": utc_now(),
    }

    if is_on_cooldown(fid, min_interval_min=3):
        result["status"] = "cooldown"
        result["message"] = "On cooldown (3 min)"
        log.info(f"[{coin.upper()}] On cooldown, skipping")
        return result

    browser = None
    try:
        with sync_playwright() as p:
            browser = p.chromium.launch(
                headless=headless,
                args=[
                    "--no-sandbox",
                    "--disable-blink-features=AutomationControlled",
                    "--disable-dev-shm-usage",
                ],
            )
            context = browser.new_context(
                user_agent="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36",
                viewport={"width": 1920, "height": 1080},
            )
            page = context.new_page()

            log.info(f"[{coin.upper()}] Loading {url}...")
            page.goto(url, wait_until="networkidle", timeout=timeout_sec * 1000)
            time.sleep(2)
            html = page.content()

            # ── Step 1: Detect captcha ──
            captcha_type = "none"
            sitekey = ""

            # Check Turnstile
            if "turnstile" in html.lower() or "cf-turnstile" in html:
                captcha_type = "turnstile"
                for pat in [r'sitekey["\s:=]+["\']([\w-]{20,})["\']', r'data-sitekey=["\']([\w-]{20,})["\']']:
                    m = re.search(pat, html)
                    if m:
                        sitekey = m.group(1)
                        break

            # Check reCAPTCHA
            if not sitekey and ("g-recaptcha" in html or "recaptcha" in html.lower()):
                captcha_type = "recaptcha"
                for pat in [r'data-sitekey=["\']([\w-]{20,})["\']', r'render["\s:,]+["\']([\w-]{20,})["\']']:
                    m = re.search(pat, html)
                    if m:
                        sitekey = m.group(1)
                        if len(sitekey) < 20 or sitekey.startswith("cc-"):
                            sitekey = ""
                            captcha_type = "none"
                        break

            # Check hCaptcha
            if not sitekey and "hcaptcha" in html.lower():
                captcha_type = "hcaptcha"
                m = re.search(r'data-sitekey=["\']([\w-]{20,})["\']', html)
                if m:
                    sitekey = m.group(1)

            result["captcha_type"] = captcha_type
            result["sitekey"] = sitekey
            if sitekey:
                log.info(f"[{coin.upper()}] Captcha: {captcha_type}, key={sitekey[:30]}...")
            else:
                log.info(f"[{coin.upper()}] No captcha detected (or inline-only)")

            # ── Step 2: Collect page info BEFORE clicking ──
            # Get all forms
            try:
                forms_info = page.evaluate('''() => {
                    const forms = document.querySelectorAll('form');
                    const result = [];
                    forms.forEach((form, i) => {
                        const inputs = [];
                        form.querySelectorAll('input, textarea, select, button').forEach(el => {
                            inputs.push({
                                tag: el.tagName, type: el.type || '',
                                name: el.name || '', id: el.id || '',
                                value: (el.value || '').substring(0, 100),
                                placeholder: (el.placeholder || '').substring(0, 50),
                                visible: el.offsetParent !== null,
                            });
                        });
                        result.push({action: form.action || '', method: form.method || '', inputs: inputs});
                    });
                    return result;
                }''')
                result["forms"] = forms_info
            except Exception as e:
                log.warning(f"[{coin.upper()}] Form extraction error: {e}")

            # Get hidden captcha tokens
            try:
                captcha_inputs = page.evaluate('''() => {
                    const inputs = [];
                    document.querySelectorAll('input[type="hidden"]').forEach(el => {
                        const n = (el.name || '').toLowerCase();
                        if (n.includes('captcha') || n.includes('token') || n.includes('turnstile') || n.includes('recaptcha')) {
                            inputs.push({name: el.name, value: (el.value || '').substring(0, 200)});
                        }
                    });
                    return inputs;
                }''')
                result["hidden_captcha_inputs"] = captcha_inputs
            except Exception as e:
                log.warning(f"[{coin.upper()}] Hidden inputs error: {e}")
            # ── Step 3: Fill FaucetPay username ──
            fp_user = load_faucetpay_username()
            if fp_user:
                for sel in [
                    'input[placeholder*="FaucetPay" i]',
                    'input[placeholder*="username" i]',
                    'input[placeholder*="FaucetPay Username" i]',
                    'input[name*="user" i]',
                    'input[name*="address" i]',
                ]:
                    try:
                        el = page.query_selector(sel)
                        if el and el.is_visible():
                            el.fill(fp_user)
                            log.info(f"[{coin.upper()}] Filled FaucetPay username via {sel}")
                            break
                    except Exception:
                        continue
                else:
                    log.warning(f"[{coin.upper()}] FaucetPay username field not found")
            # ── Step 4: Solve captcha if detected ──
            captcha_token = None
            if sitekey and captcha_type in ("recaptcha", "turnstile") and api_key:
                log.info(f"[{coin.upper()}] Solving {captcha_type} via 2Captcha...")
                captcha_token = solve_recaptcha_2captcha(api_key, sitekey, url)
                if captcha_token:
                    # Inject reCAPTCHA token
                    if captcha_type == "recaptcha":
                        try:
                            page.evaluate('''(token) => {
                                let ta = document.querySelector('textarea[name="g-recaptcha-response"]');
                                if (ta) ta.value = token;
                            }''', captcha_token)
                        except Exception:
                            pass
                    # Inject Turnstile token
                    if captcha_type == "turnstile":
                        try:
                            page.evaluate('''(token) => {
                                let inp = document.querySelector('input[name="cf-turnstile-response"]');
                                if (inp) inp.value = token;
                                document.querySelectorAll("[data-turnstile-response]").forEach(function(el) {
                                    el.setAttribute("data-turnstile-response", token);
                                });
                            }''', captcha_token)
                        except Exception:
                            pass
                    time.sleep(1)

            # ── Step 5: Click claim button ──
            claim_selectors = [
                'button:has-text("Claim")',
                'button:has-text("claim")',
                'button:has-text("Get Reward")',
                'button:has-text("Roll")',
                'button[type="submit"]',
                'input[type="submit"]',
                'button#claim',
                'button.claim-button',
                '.claim-btn',
                '#claim-button',
                'button.btn-primary',
            ]

            claim_clicked = False
            for sel in claim_selectors:
                try:
                    el = page.query_selector(sel)
                    if el and el.is_visible():
                        el_text = el.inner_text().strip()[:60]
                        log.info(f"[{coin.upper()}] Clicking: '{el_text}' via {sel}")
                        el.click()
                        claim_clicked = True
                        break
                except Exception:
                    continue

            if not claim_clicked:
                try:
                    page.evaluate('''() => {
                        const btn = document.querySelector('button[type="submit"], input[type="submit"], .btn, button');
                        if (btn) btn.click();
                    }''')
                    claim_clicked = True
                    log.info(f"[{coin.upper()}] JS fallback click")
                except Exception:
                    pass

            # ── Step 6: Wait and analyze result ──
            if claim_clicked:
                time.sleep(5)
                # Wait for any network activity to finish
                try:
                    page.wait_for_load_state("networkidle", timeout=10000)
                except Exception:
                    pass

                post_html = page.content()

                # Save post-click HTML for analysis
                try:
                    debug_path = f"/tmp/claimclicks_{coin}_post_{int(time.time())}.html"
                    with open(debug_path, "w") as f:
                        f.write(post_html)
                    log.info(f"[{coin.upper()}] Post-click HTML saved: {debug_path}")
                except Exception:
                    pass

                # Screenshot
                try:
                    ss_path = f"/tmp/claimclicks_{coin}_{int(time.time())}.png"
                    page.screenshot(path=ss_path, full_page=True)
                    log.info(f"[{coin.upper()}] Screenshot: {ss_path}")
                except Exception:
                    pass

                # Check for success/error
                combined = post_html.lower()

                # Simple keyword search (no regex groups to avoid "no such group" error)
                success_keywords = ["claimed successfully", "sent to your", "reward claimed",
                                    "you received", "congratulations", "successfully claimed",
                                    "claim successful", "has been sent"]
                error_keywords = ["already claimed", "wait", "cooldown", "rate limit",
                                  "invalid address", "wrong address", "captcha failed",
                                  "captcha incorrect", "try again", "error occurred",
                                  "failed", "incorrect captcha", "please wait"]

                success = any(kw in combined for kw in success_keywords)
                error_found = False
                error_msg = ""

                if not success:
                    for kw in error_keywords:
                        if kw in combined:
                            error_found = True
                            error_msg = kw
                            break

                # Extract amount
                amount_match = ""
                amt_patterns = [
                    r'(\d+\.?\d*)\s*(?:satoshi|sat|DOGE|LTC|BCH|DASH|TRX|BTC)',
                    r'won\s+(\d+\.?\d*)',
                    r'claimed\s+(\d+\.?\d*)',
                    r'reward.*?(\d+\.?\d*)',
                ]
                for pat in amt_patterns:
                    try:
                        m = re.search(pat, post_html, re.IGNORECASE)
                        if m:
                            amount_match = m.group(1)
                            break
                    except Exception:
                        continue

                if success:
                    result["status"] = "claimed"
                    result["amount"] = amount_match or "unknown"
                    result["message"] = "Claim successful"
                    log.info(f"[{coin.upper()}] CLAIMED! Amount: {amount_match or 'unknown'}")
                elif error_found:
                    result["status"] = "error"
                    result["message"] = error_msg
                    log.warning(f"[{coin.upper()}] Error: {error_msg}")
                else:
                    result["status"] = "clicked_unknown"
                    result["message"] = "Clicked, result unclear — check HTML"
                    log.info(f"[{coin.upper()}] Clicked but unclear result")

                # Also check for alert/dialog
                try:
                    dialog_text = ""
                    def handle_dialog(dialog):
                        nonlocal dialog_text
                        dialog_text = dialog.message
                        dialog.accept()
                    page.on("dialog", handle_dialog)
                except Exception:
                    pass

            else:
                result["status"] = "no_button"
                result["message"] = "No claim button found"
                log.warning(f"[{coin.upper()}] No claim button!")

                # Save HTML for analysis
                try:
                    debug_path = f"/tmp/claimclicks_{coin}_{int(time.time())}.html"
                    with open(debug_path, "w") as f:
                        f.write(html)
                    log.info(f"[{coin.upper()}] HTML saved: {debug_path}")
                except Exception:
                    pass

            # Get post-click hidden inputs
            try:
                post_captcha = page.evaluate('''() => {
                    const inputs = [];
                    document.querySelectorAll('input[type="hidden"]').forEach(el => {
                        const n = (el.name || '').toLowerCase();
                        if (n.includes('captcha') || n.includes('token') || n.includes('turnstile') || n.includes('recaptcha')) {
                            inputs.push({name: el.name, value: (el.value || '').substring(0, 200)});
                        }
                    });
                    return inputs;
                }''')
                if post_captcha:
                    result["post_click_hidden"] = post_captcha
            except Exception:
                pass

            browser.close()
            browser = None

    except PlaywrightTimeout:
        result["status"] = "timeout"
        result["message"] = f"Page load timeout ({timeout_sec}s)"
        log.error(f"[{coin.upper()}] Timeout")
    except Exception as e:
        result["status"] = "exception"
        result["message"] = str(e)[:300]
        log.error(f"[{coin.upper()}] Exception: {e}")
    finally:
        try:
            if browser:
                browser.close()
        except Exception:
            pass

    # Set cooldown
    set_cooldown(fid)

    # Log to ledger
    append_ledger(
        coin=coin,
        faucet_id=fid,
        amount=result.get("amount", "0"),
        status=result["status"],
        details=result.get("message", ""),
    )

    return result


# ─── Batch runner ────────────────────────────────────────

def run_claimclicks_batch(
    coins: Optional[List[str]] = None,
    api_key: str = "",
    wallet_address: str = DOGE_WALLET,
    headless: bool = True,
) -> List[Dict[str, Any]]:
    target_coins = coins or list(CLAIMCLICKS_FAUCETS.keys())
    results = []

    for coin in target_coins:
        coin_lower = coin.lower()
        if coin_lower not in CLAIMCLICKS_FAUCETS:
            log.warning(f"Unknown coin: {coin}, skipping")
            continue

        url = CLAIMCLICKS_FAUCETS[coin_lower]
        log.info(f"{'='*50} {coin.upper()} ({url}) {'='*50}")

        r = claim_one_faucet(
            coin=coin_lower,
            url=url,
            api_key=api_key,
            wallet_address=wallet_address,
            headless=headless,
        )
        results.append(r)

        # Print form details for debugging
        if r.get("forms"):
            log.info(f"[{coin.upper()}] Forms found: {len(r['forms'])}")
            for fi, form in enumerate(r["forms"]):
                log.info(f"  Form {fi}: method={form.get('method','')} action={form.get('action','')[:80]}")
                for inp in form.get("inputs", []):
                    log.info(f"    {inp['tag']} name={inp['name']} type={inp['type']} visible={inp.get('visible',False)} placeholder='{inp.get('placeholder','')}'")

        if r.get("hidden_captcha_inputs"):
            log.info(f"[{coin.upper()}] Hidden captcha inputs: {r['hidden_captcha_inputs']}")
        if r.get("post_click_hidden"):
            log.info(f"[{coin.upper()}] Post-click hidden: {r['post_click_hidden']}")

        # Delay between faucets
        if coin_lower != target_coins[-1].lower():
            time.sleep(5)

    return results


def print_results(results: List[Dict[str, Any]]) -> None:
    print("\n" + "=" * 75)
    print("CLAIMCLICKS BATCH RESULTS")
    print("=" * 75)
    print(f"{'COIN':<6} {'STATUS':<22} {'CAPTCHA':<12} {'AMOUNT':<14} {'MESSAGE'}")
    print("-" * 75)

    claimed = 0
    for r in results:
        coin = r["coin"].upper()
        status = r["status"]
        captcha = r.get("captcha_type", "none")
        amount = r.get("amount", "0")
        msg = (r.get("message", ""))[:30]

        if status == "claimed":
            claimed += 1

        print(f"{coin:<6} {status:<22} {captcha:<12} {amount:<14} {msg}")

    print("-" * 75)
    print(f"Total: {len(results)} | Claimed: {claimed} | Failed: {len(results) - claimed}")
    print("=" * 75)


def main():
    parser = argparse.ArgumentParser(description="ClaimClicks Playwright Claimer v2")
    parser.add_argument("--coins", type=str, default=None, help="Comma-separated coins (e.g., btc,doge)")
    parser.add_argument("--loop", action="store_true", help="Run in loop")
    parser.add_argument("--interval", type=int, default=180, help="Loop interval in seconds (default: 180)")
    parser.add_argument("--one-shot", action="store_true", help="Single claim and exit")
    parser.add_argument("--headed", action="store_true", help="Run browser visible")
    parser.add_argument("--api-key", type=str, default=None, help="2Captcha API key")
    parser.add_argument("--wallet", type=str, default=DOGE_WALLET, help="DOGE wallet address")
    args = parser.parse_args()

    api_key = args.api_key
    if not api_key:
        cfg = load_json(FAUCET_CFG, {})
        api_key = cfg.get("captcha", {}).get("2captcha", {}).get("api_key", "")

    if not api_key:
        print("ERROR: No 2Captcha API key")
        sys.exit(1)

    coins = None
    if args.coins:
        coins = [c.strip().lower() for c in args.coins.split(",")]

    iteration = 0
    while True:
        iteration += 1
        log.info(f"{'='*50} ITERATION #{iteration} {'='*50}")

        results = run_claimclicks_batch(
            coins=coins,
            api_key=api_key,
            wallet_address=args.wallet,
            headless=not args.headed,
        )
        print_results(results)

        if args.one_shot or not args.loop:
            break

        log.info(f"Sleeping {args.interval}s...")
        time.sleep(args.interval)


if __name__ == "__main__":
    main()