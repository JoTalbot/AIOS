[Unit]
Description=AIOS Public Orderbook Research Collector (no trading)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/AIOS
Environment=PYTHONPATH=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python -u /root/AIOS/scripts/collect_orderbook_snapshots.py daemon --symbols BTC ETH SOL --exchanges binance kucoin mexc okx bitstamp coinbase --interval 5 --depth 10 --retention-days 14
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
