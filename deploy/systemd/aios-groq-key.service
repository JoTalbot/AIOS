[Unit]
Description=AIOS Groq API key retry loop (Turnstile bypass watcher)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/AIOS
Environment=PYTHONPATH=/root/AIOS:/tmp
ExecStart=/opt/aios/.venv/bin/python -u /root/AIOS/groq_key_retry.py
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
