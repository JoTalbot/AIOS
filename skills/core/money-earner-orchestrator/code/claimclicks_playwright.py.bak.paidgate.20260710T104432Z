    "btc": "https://claimclicks.com/btc",
    "doge": "https://claimclicks.com/doge",
    "ltc": "https://claimclicks.com/ltc",
    "bch": "https://claimclicks.com/bch",
    "dash": "https://claimclicks.com/dash",
    "trx": "https://claimclicks.com/trx",
}

DOGE_WALLET = "DAkkVZcUqtdDWLMdbBb4jaTqrZysY2kREv"

def load_faucetpay_username():
    try:
        cfg = json.loads(FAUCET_CFG.read_text(encoding="utf-8"))
        return cfg.get("faucetpay_username", "")
    except Exception:
