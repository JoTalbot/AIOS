[Unit]
Description=WAL-safe backup of encrypted AIOS Telegram queues
After=local-fs.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/AIOS
Environment=AIOS_TELEGRAM_STATE_DIR=/var/lib/aios/telegram
Environment=AIOS_TELEGRAM_BACKUP_DIR=/var/backups/aios/telegram-queues
Environment=AIOS_TELEGRAM_KEY_BACKUP_DIR=/var/backups/aios/telegram-queue-keys
ExecStart=/opt/aios/.venv/bin/python /root/AIOS/scripts/telegram_queue_backup.py --keep-days 30
UMask=0077
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/etc/aios/credentials
# SQLite may update its shared-memory sidecar while reading a live WAL database.
ReadWritePaths=/var/lib/aios/telegram /var/backups/aios/telegram-queues /var/backups/aios/telegram-queue-keys
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH
