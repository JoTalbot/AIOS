[Unit]
Description=AIOS Android Mesh Fleet v20 - multi-device registry, lease, heartbeat, reap stale
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/AIOS
Environment=PYTHONPATH=/root/AIOS
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/aios/.venv/bin/python -u /root/AIOS/run_android_mesh.py --daemon --interval 60
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
