[Unit]
Description=AIOS Colab LLM (qwen2.5-coder GPU) & Keeper
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/AIOS
Environment=DISPLAY=:1
Environment=PYTHONPATH=/root/AIOS
Environment=COLAB_SERVICE_KIND=llm
Environment=COLAB_SERVICE_NAME=colab-llm
Environment=COLAB_LLM_MODEL=colab/qwen2.5-coder
Environment=COLAB_CDP_URL=http://localhost:9223
ExecStart=/opt/aios/.venv/bin/python -u /root/AIOS/scripts/colab_automation_runner.py
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
