PUBLIC_PATHS={'/health','/docs','/openapi.json','/redoc','/pricing','/offers','/lead'}
def _auth_key(raw:str):
    h=hashlib.sha256(raw.encode()).hexdigest()
    try: keys=json.loads((CFG/'income_mvp_api_keys.json').read_text())
    except Exception: keys={'keys':[]}
    return next((x for x in keys.get('keys',[]) if x.get('enabled') and x.get('key_sha256')==h),None)
def _module_for_path(path:str):
    parts=[x for x in path.split('/') if x]
    return parts[1] if len(parts)>1 and parts[0]=='v1' else 'unknown'
def _count_today(name:str):
    if not USAGE.exists(): return 0
    today=datetime.now(timezone.utc).date().isoformat(); n=0
    with USAGE.open() as f:
        for line in f:
            try:
                x=json.loads(line); n += int(str(x.get('ts','')).startswith(today) and x.get('key_name')==name)
            except Exception: pass
    return n
@app.middleware('http')
async def auth_meter(request:Request, call_next):
    if request.url.path in PUBLIC_PATHS:
        return await call_next(request)
    raw=request.headers.get('x-api-key',''); rec=_auth_key(raw)
    if not rec: return __import__('fastapi').responses.JSONResponse({'detail':'invalid api key'},status_code=401)
    plan=PRICING['plans'].get(rec.get('plan','free'),PRICING['plans']['free']); used=_count_today(rec['name'])
    if used>=int(plan['requests_per_day']): return __import__('fastapi').responses.JSONResponse({'detail':'daily quota exceeded'},status_code=429)
    module=_module_for_path(request.url.path); allowed=plan.get('modules',[])
    if 'all' not in allowed and module not in allowed: return __import__('fastapi').responses.JSONResponse({'detail':'module not in plan'},status_code=403)
    started=time.perf_counter(); response=await call_next(request)
    event={'ts':datetime.now(timezone.utc).isoformat(),'key_name':rec['name'],'plan':rec['plan'],'path':request.url.path,'module':module,'status_code':response.status_code,'latency_ms':round((time.perf_counter()-started)*1000,2)}
    DATA.mkdir(parents=True,exist_ok=True)
    with open(USAGE,'a') as f:
        fcntl.flock(f.fileno(),fcntl.LOCK_EX); f.write(json.dumps(event,ensure_ascii=False)+'\n'); f.flush(); os.fsync(f.fileno()); fcntl.flock(f.fileno(),fcntl.LOCK_UN)
    response.headers['x-ratelimit-limit']=str(plan['requests_per_day']); response.headers['x-ratelimit-remaining']=str(max(0,int(plan['requests_per_day'])-used-1))
    return response
