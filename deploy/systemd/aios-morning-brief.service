[Unit]
Description=AIOS Morning Brief (07:30 Kyiv)
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python /root/AIOS/run_morning_brief.py
StandardOutput=append:/root/AIOS/logs/morning_brief.log
StandardError=append:/root/AIOS/logs/morning_brief.log
