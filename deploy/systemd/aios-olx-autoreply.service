[Unit]
Description=AIOS OLX Autoreply (Autonomous LLM loop)
After=network-online.target aios-chrome-vnc.service
Wants=network-online.target

[Service]
WorkingDirectory=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python -u /root/AIOS/run_autonomy_cli.py olx --loop --interval 300
Restart=always
RestartSec=15
StandardOutput=append:/root/AIOS/logs/olx_autoreply.log
StandardError=append:/root/AIOS/logs/olx_autoreply.log

[Install]
WantedBy=multi-user.target
