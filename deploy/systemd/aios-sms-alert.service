[Unit]
Description=AIOS SMS Alerts (Messages for Web -> Telegram)
After=network.target aios-chrome-vnc.service

[Service]
Type=oneshot
WorkingDirectory=/root/AIOS
Environment=AIOS_CHROME_CDP=http://127.0.0.1:9222
ExecStart=/opt/aios/.venv/bin/python /root/AIOS/run_sms_alerts.py --check
EnvironmentFile=/etc/aios/aios-telegram-bot.env
StandardOutput=append:/root/AIOS/logs/sms_alerts.log
StandardError=append:/root/AIOS/logs/sms_alerts.log
