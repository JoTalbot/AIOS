#!/usr/bin/env python3
import json
from datetime import datetime, timezone
from pathlib import Path
ROOT=Path('/root/agents/-Octopus'); B=ROOT/'skills/core/money-earner-orchestrator'
def load(p,d):
    try:return json.loads(Path(p).read_text())
    except Exception:return d
budget=load(B/'data/daily_captcha_budget.json',{})
audit=load(B/'data/captcha_budget_audit_latest.json',{})
opp=load(B/'data/opportunity_aggregate_latest.json',{})
metrics=load(B/'data/metrics_snapshot_latest.json',{})
ra=load(B/'data/roadmap_audit_latest.json',{})
verified=int(opp.get('live_verified_total',opp.get('verified_total',0)) or 0)
audit_errors=int(ra.get('errors',0) or 0)
compliant=bool(audit.get('compliant',False))
phase1='complete' if audit_errors==0 and compliant else 'active'
out={'generated_at':datetime.now(timezone.utc).isoformat(),'current_level':'L0','phase_status':{'phase_1_accounting':phase1,'phase_2_roi':'active' if phase1=='complete' else 'pending','phase_3_income_sources':'pending','phase_4_services':'pending','phase_5_scale':'pending','phase_6_self_sufficiency':'pending'},'kpi':{'captcha_spent_usd':budget.get('spent_usd',0),'captcha_solves':budget.get('solves',0),'captcha_policy_compliant':compliant,'audit_errors':audit_errors,'verified_bounties':verified,'confirmed_sats':0,'paper_realized_pnl_usd':metrics.get('paper_realized_pnl_usd')},'blockers':[x for x,v in [('audit_errors',audit_errors!=0),('captcha_policy_noncompliant',not compliant),('no_verified_bounties',verified<1),('no_confirmed_income',True)] if v],'next_actions':['dynamic_daily_summary_policy','currency_separated_ledger','automatic_source_roi_gate','first_confirmed_non_faucet_payout']}
(B/'data/self_sufficiency_status_latest.json').write_text(json.dumps(out,ensure_ascii=False,indent=2)+'\n')
print(json.dumps(out,ensure_ascii=False))
