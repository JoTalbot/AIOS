[Unit]
Description=AIOS Google Drive Auto Sync Watchdog (Calls & Dictaphone Ambient Voice)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/AIOS
Environment=PYTHONPATH=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python -u /root/AIOS/scripts/gdrive_auto_sync_watchdog.py
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
