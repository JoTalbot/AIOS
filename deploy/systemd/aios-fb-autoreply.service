[Unit]
Description=AIOS Facebook Messenger Autoreply (Autonomous LLM loop)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python -u /root/AIOS/run_platform_autoreply.py facebook --loop --interval 300
Restart=always
RestartSec=15
StandardOutput=append:/root/AIOS/logs/fb_autoreply.log
StandardError=append:/root/AIOS/logs/fb_autoreply.log

[Install]
WantedBy=multi-user.target
