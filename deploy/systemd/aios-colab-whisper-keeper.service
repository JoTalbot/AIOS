[Unit]
Description=AIOS Google Colab Whisper GPU Automated Runner & Keeper
After=network.target aios-chrome-vnc.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/AIOS
Environment=DISPLAY=:1
Environment=PYTHONPATH=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python -u /root/AIOS/scripts/colab_automation_runner.py whisper
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
