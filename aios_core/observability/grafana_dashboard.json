{
  "dashboard": {
    "title": "AIOS - Full Overview",
    "panels": [
      {
        "title": "Messages Received (by Platform)",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [{"expr": "rate(aios_messages_received_total[5m])", "legendFormat": "{{platform}}"}],
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}
      },
      {
        "title": "Agent Requests (by Agent)",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [{"expr": "rate(aios_agent_requests_total[5m])", "legendFormat": "{{agent_name}} - {{action}}"}],
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}
      },
      {
        "title": "Agent Processing Time (p95)",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [{"expr": "histogram_quantile(0.95, rate(aios_agent_processing_seconds_bucket[5m]))", "legendFormat": "{{agent_name}}"}],
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}
      },
      {
        "title": "Agent Confidence Distribution",
        "type": "heatmap",
        "datasource": "Prometheus",
        "targets": [{"expr": "rate(aios_agent_confidence_bucket[5m])", "legendFormat": "{{agent_name}}"}],
        "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}
      },
      {
        "title": "Drafts: Created vs Approved vs Rejected",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {"expr": "rate(aios_drafts_created_total[5m])", "legendFormat": "Created"},
          {"expr": "rate(aios_drafts_approved_total[5m])", "legendFormat": "Approved"},
          {"expr": "rate(aios_drafts_rejected_total[5m])", "legendFormat": "Rejected"}
        ],
        "gridPos": {"x": 0, "y": 16, "w": 24, "h": 8}
      }
    ]
  }
}
