# ─── Helpers ─────────────────────────────────────────────

def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat()

def load_json(path: Path, default: Any = None) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return default if default is not None else {}

def save_json(path: Path, data: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2, ensure_ascii=False), encoding="utf-8")

def load_config() -> Dict[str, Any]:
    return load_json(FAUCET_CFG, {})

def load_catalog() -> List[Dict[str, Any]]:
    cfg = load_json(CATALOG_FILE, {})
    if isinstance(cfg, dict) and isinstance(cfg.get("faucets"), list):
        return cfg["faucets"]
    if isinstance(cfg, list):
        return cfg
    return []

def load_cooldowns() -> Dict[str, Any]:
    return load_json(COOLDOWN_FILE, {"cooldowns": {}})

def save_cooldowns(cd: Dict[str, Any]) -> None:
    save_json(COOLDOWN_FILE, cd)

def is_on_cooldown(fid: str, min_interval_min: int = 15) -> bool:
    """Проверить, находится ли кран в cooldown."""
    cd = load_cooldowns()
    last = cd.get("cooldowns", {}).get(fid)
    if not last:
        return False
    try:
        last_ts = datetime.fromisoformat(last)
        elapsed = (datetime.now(timezone.utc) - last_ts).total_seconds() / 60
        return elapsed < min_interval_min
    except Exception:
        return False

def set_cooldown(fid: str) -> None:
    cd = load_cooldowns()
    if "cooldowns" not in cd:
        cd["cooldowns"] = {}
    cd["cooldowns"][fid] = utc_now()
    save_cooldowns(cd)


# ============================================================
# PHASE 0: FILTER — подготовка списка кранов
# ============================================================

def filter_faucets(
    faucets: List[Dict],
    coins: Optional[List[str]] = None,
    include_testnet: bool = False,
    max_priority: int = 3,
) -> List[Dict]:
    """Отфильтровать краны по монете, сети, приоритету."""
    result = []
    for f in faucets:
        # Фильтр по монете
        if coins:
            coin = f.get("coin", "BTC").upper()
            if coin != "MULTI" and coin not in [c.upper() for c in coins]:
                continue

        # Фильтр по сети
        if not include_testnet and f.get("network") in ("testnet", "devnet"):
            continue

        # Фильтр по приоритету (1=лучший, 5=мёртвый)
        if f.get("priority", 3) > max_priority:
            continue

        result.append(f)

    return result


# ============================================================
# PHASE 1: PROBE — параллельная проверка живости
# ============================================================

def probe_one(faucet: Dict[str, Any]) -> Dict[str, Any]:
    """Быстрый HTTP HEAD/GET для проверки живости одного крана."""
    url = faucet.get("url", "")
    fid = faucet.get("id", "?")
    sitekey = faucet.get("captcha_sitekey", "")

    result = {
        "id": fid,
        "name": faucet.get("name", ""),
        "url": url,
        "coin": faucet.get("coin", "BTC"),
        "alive": False,
        "http_status": 0,
        "has_captcha": False,
        "captcha_type_detected": "",
        "captcha_sitekey": sitekey,
        "has_lnurl": False,
        "has_lightning": False,
        "has_faucetpay": False,
        "mechanism": faucet.get("mechanism", "unknown"),
        "auth_required": faucet.get("auth_required", False),
        "network": faucet.get("network", "mainnet"),
        "api_endpoint": faucet.get("api_endpoint", ""),
        "priority": faucet.get("priority", 3),
    }

    try:
        # Сначала HEAD для скорости
        try:
            req = urllib.request.Request(url, method="HEAD", headers={"User-Agent": UA})
            with urllib.request.urlopen(req, timeout=10) as resp:
                result["alive"] = True
                result["http_status"] = resp.status
        except urllib.error.HTTPError as e:
            # HEAD может не поддерживаться — пробуем GET
            if e.code in (405, 501):
                raise  # перехватывается ниже
            result["http_status"] = e.code
            result["alive"] = e.code < 500
            return result

        # Для живых сайтов — GET для анализа контента
        req = urllib.request.Request(url, headers={"User-Agent": UA})
        with urllib.request.urlopen(req, timeout=12) as resp:
            html = resp.read().decode("utf-8", errors="replace")
            result["alive"] = True
            result["http_status"] = resp.status
            result["html_len"] = len(html)

            low = html.lower()

            # Обнаружение капчи — сначала все проверки, потом приоритеты
            _has_turnstile = "turnstile" in low
            _has_hcaptcha = "hcaptcha" in low or "h-captcha" in low
            _has_recaptcha = "g-recaptcha" in low or "google.com/recaptcha" in low

            # Приоритет: если есть и Turnstile и что-то ещё — это Turnstile
            if _has_turnstile:
                has_turnstile = True
                has_hcaptcha = False
                has_recaptcha = False
            elif _has_hcaptcha:
                has_turnstile = False
                has_hcaptcha = True
                has_recaptcha = False
            elif _has_recaptcha:
                has_turnstile = False
                has_hcaptcha = False
                has_recaptcha = True
            else:
                has_turnstile = has_hcaptcha = has_recaptcha = False

            result["has_captcha"] = has_turnstile or has_hcaptcha or has_recaptcha
            if has_turnstile:
                result["captcha_type_detected"] = "turnstile"
            elif has_hcaptcha:
                result["captcha_type_detected"] = "hcaptcha"
            elif has_recaptcha:
                result["captcha_type_detected"] = "recaptcha"

            # Извлечение sitekey если нет в каталоге (НЕ для Turnstile)
            if result["has_captcha"] and not sitekey and not has_turnstile:
                for pattern in [
                    r'data-sitekey=["\']([\w-]+)["\']',
                    r'sitekey["\s:]+["\']([\w-]+)["\']',
                    r'\.render\(\s*["\']([\w-]+)["\']',  # reCAPTCHA API render
                ]:
                    m = re.search(pattern, html, re.IGNORECASE)
                    if m:
                        sk = m.group(1)
                        # Фильтр: рекламные data-key НЕ являются sitekey
                        if len(sk) >= 20 and not sk.startswith("cc-"):
                            result["captcha_sitekey"] = sk
                            break

            # Обнаружение механизма
            result["has_lnurl"] = "lnurl" in low
            result["has_lightning"] = "lightning" in low
            result["has_faucetpay"] = "faucetpay" in low

            if "lnurl" in low:
                result["mechanism"] = "lnurl_withdraw"
            elif "faucetpay" in low:
                result["mechanism"] = "faucetpay_web"

    except urllib.error.HTTPError as e:
        result["http_status"] = e.code
        result["alive"] = e.code < 500
    except Exception as e:
        err = str(e)[:80]
        result["error"] = err
        # Мёртвые краны с timeout/connection — не нужно часто пробовать
        if any(x in err.lower() for x in ["timed out", "connection", "resolve", "refused"]):
            set_cooldown(fid)

    return result


def classify_probe(p: Dict[str, Any]) -> str:
    """Классификация по результату probe."""
    if not p.get("alive"):
        return "dead"
    if p.get("network") in ("testnet", "devnet"):
        return "testnet"
    if p.get("auth_required"):
        return "auth_required"

    # Если есть sitekey (из каталога или обнаружен) — можно решать
    if p.get("captcha_sitekey"):
        return "captcha_solvable"

    # Turnstile — auto-solved в браузере CF, пробуем напрямую (claimable)
    if p.get("has_captcha") and p.get("captcha_type_detected") == "turnstile":
        return "claimable"
    # Есть другая капча но нет sitekey
    if p.get("has_captcha"):
        return "captcha_blocked"

    # Нет капчи, есть LN/Lightning
    if p.get("has_lnurl") or p.get("has_lightning"):
        return "claimable"

    # FaucetPay без капчи — возможен клейм
    if p.get("has_faucetpay"):
        return "claimable"

    return "needs_investigation"


def phase_probe(faucets: List[Dict], max_workers: int = 15) -> List[Dict]:
    """Параллельный probe всех кранов."""
    log.info(f"Phase PROBE: {len(faucets)} кранов, {max_workers} workers параллельно...")
    results = []
    with ThreadPoolExecutor(max_workers=max_workers) as pool:
        futures = {pool.submit(probe_one, f): f for f in faucets}
        for future in as_completed(futures):
            try:
                r = future.result()
            except Exception as e:
                r = {"id": "error", "error": str(e)}

            r["claim_class"] = classify_probe(r)
            results.append(r)

            icons = {
                "captcha_solvable": ">>",
                "captcha_turnstile": "TC",
                "claimable": "OK",
                "dead": "XX",
                "auth_required": "AU",
                "captcha_blocked": "XC",
                "needs_investigation": "??",
                "testnet": "TT",
            }
            icon = icons.get(r["claim_class"], "??")
            coin = r.get("coin", "?")
            log.info(
                f"  [{icon}] {coin:<5} {r['id']:<28} "
                f"HTTP={r['http_status']:<4} "
                f"cap={r.get('captcha_type_detected', '-'):<12} "
                f"key={'Y' if r.get('captcha_sitekey') else '-'} "
                f"ln={r.get('has_lnurl', '-')}"
            )
    return results


# ============================================================
# PHASE 2: SOLVE — параллельное решение капч
# ============================================================

def solve_hcaptcha_2captcha(api_key: str, sitekey: str, url: str) -> Optional[str]:
    """Решить hCaptcha через 2Captcha."""
    payload = json.dumps({
        "clientKey": api_key,
        "task": {
            "type": "HCaptchaTaskProxyless",
            "websiteURL": url,
            "websiteKey": sitekey,
        },
    }).encode()
    req = urllib.request.Request(
        "https://api.2captcha.com/createTask",
        data=payload,
        headers={"Content-Type": "application/json"},
    )
    with urllib.request.urlopen(req, timeout=60) as resp:
        result = json.loads(resp.read().decode())

    task_id = result.get("taskId")
    if not task_id or result.get("errorId", 0) != 0:
        return None

    for _ in range(60):
        time.sleep(3)
        payload = json.dumps({"clientKey": api_key, "taskId": task_id}).encode()
        req = urllib.request.Request(
            "https://api.2captcha.com/getTaskResult",
            data=payload,
            headers={"Content-Type": "application/json"},
        )
        with urllib.request.urlopen(req, timeout=60) as resp:
            result = json.loads(resp.read().decode())
        if result.get("status") == "ready":
            return result.get("solution", {}).get("gRecaptchaResponse", "")
        if result.get("errorId", 0) != 0:
            return None
    return None


def solve_recaptcha_2captcha(api_key: str, sitekey: str, url: str) -> Optional[str]:
    """Решить reCAPTCHA v2/v3 через 2Captcha."""
    payload = json.dumps({
        "clientKey": api_key,
        "task": {
            "type": "RecaptchaV2TaskProxyless",
            "websiteURL": url,
            "websiteKey": sitekey,
        },
    }).encode()
    req = urllib.request.Request(
        "https://api.2captcha.com/createTask",
        data=payload,
        headers={"Content-Type": "application/json"},
    )
    with urllib.request.urlopen(req, timeout=60) as resp:
        result = json.loads(resp.read().decode())

    task_id = result.get("taskId")
    if not task_id or result.get("errorId", 0) != 0:
        return None

    for _ in range(60):
        time.sleep(3)
        payload = json.dumps({"clientKey": api_key, "taskId": task_id}).encode()
        req = urllib.request.Request(
            "https://api.2captcha.com/getTaskResult",
            data=payload,
            headers={"Content-Type": "application/json"},
        )
        with urllib.request.urlopen(req, timeout=60) as resp:
            result = json.loads(resp.read().decode())
        if result.get("status") == "ready":
            return result.get("solution", {}).get("gRecaptchaResponse", "")
        if result.get("errorId", 0) != 0:
            return None
    return None


def solve_one(faucet: Dict, api_key: str) -> Tuple[str, Optional[str], str]:
    """Решить капчу для одного крана. (faucet_id, token, captcha_type)."""
    fid = faucet.get("id", "?")
    sitekey = faucet.get("captcha_sitekey", "")
    url = faucet.get("url", "")
    cap_type = faucet.get("captcha_type_detected", faucet.get("captcha_type", "hcaptcha"))

    if not sitekey:
        return fid, None, cap_type

    log.info(f"  [{fid}] Solving {cap_type} (key={sitekey[:16]}...)")
    t0 = time.time()

    try:
        token = None
        if cap_type == "hcaptcha":
            token = solve_hcaptcha_2captcha(api_key, sitekey, url)
        elif cap_type == "recaptcha":
            token = solve_recaptcha_2captcha(api_key, sitekey, url)
        else:
            # Попробовать hCaptcha как дефолт
            token = solve_hcaptcha_2captcha(api_key, sitekey, url)

        elapsed = time.time() - t0
        if token:
            log.info(f"  [{fid}] SOLVED in {elapsed:.0f}s (len={len(token)})")
        else:
            log.warning(f"  [{fid}] FAILED after {elapsed:.0f}s")
        return fid, token, cap_type
    except Exception as e:
        log.error(f"  [{fid}] Error: {e}")
        return fid, None, cap_type


def check_budget(config: Dict, count: int = 1) -> bool:
    """Проверить и зарезервировать бюджет."""
    captcha = config.get("captcha", {})
    max_daily = captcha.get("max_daily_budget_usd", 0.50)
    max_per = captcha.get("max_cost_per_solve_usd", 0.003)

    budget = load_json(BUDGET_FILE, {"date": "", "spent_usd": 0.0, "solves": 0})
    today = datetime.now(timezone.utc).strftime("%Y-%m-%d")
    if budget.get("date") != today:
        budget = {"date": today, "spent_usd": 0.0, "solves": 0}

    remaining_solves = int((max_daily - budget["spent_usd"]) / max_per)
    return remaining_solves >= count


def record_spends(count: int, config: Dict) -> float:
    """Атомарно записать расходы. Возвращает фактическую стоимость."""
    max_per = config.get('captcha', {}).get('max_cost_per_solve_usd', 0.003)
    cost = count * max_per
    atomic_record_spend(BUDGET_FILE, cost, source='faucet_batch_runner_v2.py', solves=count)
    return cost

def phase_solve(
    probes: List[Dict], config: Dict, max_workers: int = 5, aggressive: bool = False
) -> Dict[str, Tuple[str, str]]:
    """Параллельно решить капчи. Возвращает {faucet_id: (token, captcha_type)}."""
    api_key = config.get("captcha", {}).get("2captcha", {}).get("api_key", "")
    if not api_key:
        log.error("Нет 2Captcha API ключа!")
        return {}

    solvable = [p for p in probes if p.get("claim_class") == "captcha_solvable"]
    if not solvable:
        log.info("Phase SOLVE: нет captcha_solvable кранов")
        return {}

    if not aggressive and not check_budget(config, len(solvable)):
        log.warning("Бюджет не позволяет решить все. Решаем сколько можем.")
        budget = load_json(BUDGET_FILE, {"date": "", "spent_usd": 0.0, "solves": 0})
        today = datetime.now(timezone.utc).strftime("%Y-%m-%d")
        if budget.get("date") != today:
            budget = {"date": today, "spent_usd": 0.0, "solves": 0}
        max_daily = config.get("captcha", {}).get("max_daily_budget_usd", 0.50)
        max_per = config.get("captcha", {}).get("max_cost_per_solve_usd", 0.003)
        remaining = max(0, int((max_daily - budget["spent_usd"]) / max_per))
        if remaining <= 0:
            log.warning("Бюджет полностью исчерпан!")
            return {}
        solvable = solvable[:remaining]

    log.info(f"Phase SOLVE: {len(solvable)} кранов, {max_workers} workers...")

    tokens: Dict[str, Tuple[str, str]] = {}
    with ThreadPoolExecutor(max_workers=max_workers) as pool:
        futures = {pool.submit(solve_one, f, api_key): f for f in solvable}
        for future in as_completed(futures):
            fid, token, cap_type = future.result()
            if token:
                tokens[fid] = (token, cap_type)

    record_spends(len(tokens), config)
    log.info(f"Phase SOLVE: {len(tokens)}/{len(solvable)} решено")
    return tokens


# ============================================================
# PHASE 3: CLAIM — параллельный клейм (множественные API)
# ============================================================

def claim_lnurl_api(faucet: Dict, token: str, captcha_type: str) -> Dict[str, Any]:
    """Клейм для LNS-типа: GET /api/lnurl1 с fingerprint параметрами."""
    fid = faucet.get("id")
    url = faucet.get("url", "")
    bfg = hashlib.md5(str(random.random()).encode()).hexdigest()[:32]
    dfg = hashlib.md5(str(uuid.uuid4()).encode()).hexdigest()[:32]

    params = urllib.parse.urlencode({
        "bfg": bfg, "dfg": dfg, "wfg": "1920x1080",
        "h-captcha-response": token,
        "g-recaptcha-response": token if captcha_type == "recaptcha" else "",
    })

    base = urllib.parse.urlparse(url).netloc
    scheme = urllib.parse.urlparse(url).scheme
    claim_url = f"{scheme}://{base}/api/lnurl1?{params}"

    headers = {
        "User-Agent": UA, "Accept": "application/json",
        "Referer": url, "Origin": f"{scheme}://{base}",
    }

    try:
        req = urllib.request.Request(claim_url, headers=headers)
        with urllib.request.urlopen(req, timeout=60) as resp:
            body = resp.read().decode("utf-8", errors="replace")
            try:
                j = json.loads(body)
            except Exception:
                return {"faucet_id": fid, "http_status": resp.status,
                        "status": "unknown", "message": body[:200], "ts": utc_now()}
            return {
                "faucet_id": fid, "http_status": resp.status,
                "status": j.get("status"), "message": j.get("message", ""),
                "data": j.get("data"), "ts": utc_now(),
            }
    except urllib.error.HTTPError as e:
        body = ""
        try:
            body = e.read().decode("utf-8", errors="replace")[:300]
        except Exception:
            pass
        return {"faucet_id": fid, "http_status": e.code,
                "status": "fail", "message": body, "ts": utc_now()}
    except Exception as e:
        return {"faucet_id": fid, "http_status": 0,
                "status": "error", "message": str(e), "ts": utc_now()}


def claim_generic_probe(faucet: Dict, token: Optional[str] = None) -> Dict[str, Any]:
    """Generic probe-claim: попытка найти и вызвать API клейма на странице."""
    fid = faucet.get("id")
    url = faucet.get("url", "")
    scheme = urllib.parse.urlparse(url).scheme
    base = urllib.parse.urlparse(url).netloc

    # Попробуем типичные API эндпоинты
    api_paths = [
        "/api/claim", "/api/faucet/claim", "/api/v1/claim",
        "/api/lnurl1", "/api/withdraw", "/api/faucet",
    ]

    headers = {
        "User-Agent": UA, "Accept": "application/json",
        "Referer": url, "Origin": f"{scheme}://{base}",
    }

    # Если есть токен — добавим в параметры
    for path in api_paths:
        try:
            if token:
                full_url = f"{scheme}://{base}{path}"
                params = urllib.parse.urlencode({
                    "h-captcha-response": token,
                    "g-recaptcha-response": token,
                    "address": "seriousslice30@walletofsatoshi.com",
                })
                req = urllib.request.Request(
                    f"{full_url}?{params}", headers=headers, method="GET"
                )
            else:
                full_url = f"{scheme}://{base}{path}"
                req = urllib.request.Request(full_url, headers=headers, method="GET")

            with urllib.request.urlopen(req, timeout=10) as resp:
                body = resp.read().decode("utf-8", errors="replace")
                return {
                    "faucet_id": fid, "http_status": resp.status,
                    "status": "found_api", "api_path": path,
                    "message": body[:200], "ts": utc_now(),
                }
        except urllib.error.HTTPError:
            continue
        except Exception:
            continue

    # Если API не найден — пробуем POST на основной URL
    try:
        if token:
            post_data = urllib.parse.urlencode({
                "h-captcha-response": token,
                "g-recaptcha-response": token,
                "address": "seriousslice30@walletofsatoshi.com",
                "action": "claim",
            }).encode()
        else:
            post_data = b"action=claim&address=seriousslice30@walletofsatoshi.com"

        req = urllib.request.Request(url, data=post_data, headers={
            **headers, "Content-Type": "application/x-www-form-urlencoded"
        })
        with urllib.request.urlopen(req, timeout=15) as resp:
            body = resp.read().decode("utf-8", errors="replace")
            return {
                "faucet_id": fid, "http_status": resp.status,
                "status": "post_attempt", "message": body[:200], "ts": utc_now(),
            }
    except Exception as e:
        return {
            "faucet_id": fid, "http_status": 0,
            "status": "no_api_found", "message": str(e)[:100], "ts": utc_now(),
        }


def phase_claim(
    probes: List[Dict], tokens: Dict[str, Tuple[str, str]], max_workers: int = 10
) -> List[Dict]:
    """Параллельный клейм."""
    probe_map = {p["id"]: p for p in probes}
    claims = []

    # --- Batch A: краны с решёнными капчами (captcha_solvable) ---
    if tokens:
        log.info(f"Phase CLAIM [A]: {len(tokens)} кранов с капчами...")
        with ThreadPoolExecutor(max_workers=max_workers) as pool:
            futures = {}
            for fid, (token, cap_type) in tokens.items():
                faucet_data = probe_map.get(fid, {})
                # LNS-type: используем известный API
                if faucet_data.get("api_endpoint") == "GET /api/lnurl1":
                    futures[pool.submit(claim_lnurl_api, faucet_data, token, cap_type)] = fid
                else:
                    # Generic: попытаемся найти API
                    futures[pool.submit(claim_generic_probe, faucet_data, token)] = fid

            for future in as_completed(futures):
                fid = futures[future]
                try:
                    result = future.result()
                except Exception as e:
                    result = {"faucet_id": fid, "status": "error", "message": str(e)}
                result["claim_type"] = "captcha_solved"
                claims.append(result)
                _log_claim(result, probe_map.get(fid, {}))

    # --- Batch B: claimable краны без капчи ---
    claimable = [p for p in probes if p.get("claim_class") == "claimable"]
    if claimable:
        log.info(f"Phase CLAIM [B]: {len(claimable)} кранов без капчи...")
        with ThreadPoolExecutor(max_workers=max_workers) as pool:
            futures = {pool.submit(claim_generic_probe, p): p["id"] for p in claimable}
            for future in as_completed(futures):
                fid = futures[future]
                try:
                    result = future.result()
                except Exception as e:
                    result = {"faucet_id": fid, "status": "error", "message": str(e)}
                result["claim_type"] = "direct"
                claims.append(result)
                _log_claim(result, probe_map.get(fid, {}))

    # --- Batch C: needs_investigation краны (попробовать всё) ---
    investigate = [p for p in probes if p.get("claim_class") == "needs_investigation"]
    if investigate:
        log.info(f"Phase CLAIM [C]: {len(investigate)} кранов на исследование...")
        with ThreadPoolExecutor(max_workers=max(3, len(investigate))) as pool:
            futures = {pool.submit(claim_generic_probe, p): p["id"] for p in investigate}
            for future in as_completed(futures):
                fid = futures[future]
                try:
                    result = future.result()
                except Exception as e:
                    result = {"faucet_id": fid, "status": "error", "message": str(e)}
                result["claim_type"] = "investigation"
                claims.append(result)
                _log_claim(result, probe_map.get(fid, {}))

    return claims


def _log_claim(result: Dict, probe: Dict) -> None:
    """Логирование результата клейма."""
    fid = result.get("faucet_id", "?")
    status = result.get("status", "?")
    http = result.get("http_status", 0)
    msg = str(result.get("message", ""))[:60]
    coin = probe.get("coin", "?")

    icon = "OK" if status == "success" else ("??" if status in ("found_api", "post_attempt") else "ERR")
    sats = result.get("data", {}).get("amount", 0) if isinstance(result.get("data"), dict) else 0
    extra = f" {sats} sats" if sats else ""

    log.info(f"  [{icon}] {coin:<5} {fid:<28} HTTP {http:<4} {status}{extra} — {msg}")

    if status == "success":
        set_cooldown(fid)


# ============================================================
# PHASE 4: REPORT — агрегация и ledger
# ============================================================

def phase_report(probes: List[Dict], claims: List[Dict], solve_time: float) -> Dict:
    """Формирование отчёта по монетам."""
    # Классификация
    classification = {}
    for p in probes:
        cc = p.get("claim_class", "unknown")
        classification[cc] = classification.get(cc, 0) + 1

    # По монетам
    by_coin = {}
    for p in probes:
        coin = p.get("coin", "BTC")
        if coin not in by_coin:
            by_coin[coin] = {"total": 0, "alive": 0, "dead": 0, "claimed": 0}
        by_coin[coin]["total"] += 1
        if p.get("alive"):
            by_coin[coin]["alive"] += 1
        else:
            by_coin[coin]["dead"] += 1

    # Успешные клеймы
    success_claims = [c for c in claims if c.get("status") == "success"]
    total_sats = 0
    for c in success_claims:
        d = c.get("data", {})
        if isinstance(d, dict):
            total_sats += d.get("amount", 0)

    # Обнаружения новых API
    api_discoveries = [c for c in claims if c.get("status") == "found_api"]

    report = {
        "ts": utc_now(),
        "mode": "parallel_batch_v2",
        "vector": "САМООБЕСПЕЧЕНИЕ",
        "phase_times_s": {"probe": "parallel", "solve": round(solve_time, 1), "claim": "parallel"},
        "probed": len(probes),
        "by_coin": by_coin,
        "classification": classification,
        "captcha_solved": len([c for c in claims if c.get("claim_type") == "captcha_solved"]),
        "claims_attempted": len(claims),
        "claims_success": len(success_claims),
        "api_discoveries": len(api_discoveries),
        "total_sats_claimed": total_sats,
        "claims": claims,
    }

    # Ledger
    ledger = load_json(LEDGER, {"vector": "САМООБЕСПЕЧЕНИЕ", "runs": [], "total_sats_claimed": 0})
    if not isinstance(ledger, dict):
        ledger = {"vector": "САМООБЕСПЕЧЕНИЕ", "runs": [], "total_sats_claimed": 0}
    ledger["runs"].append(report)
    ledger["total_sats_claimed"] = ledger.get("total_sats_claimed", 0) + total_sats
    ledger["updated"] = utc_now()
    save_json(LEDGER, ledger)

    return report


def print_report(report: Dict) -> None:
    """Красивый вывод."""
    r = report
    print(f"\n{'='*65}")
    print(f"  MULTI-CURRENCY BATCH RUN  {r['ts']}")
    print(f"{'='*65}")

    # По монетам
    print(f"\n  По монетам:")
    for coin, stats in r.get("by_coin", {}).items():
        print(f"    {coin:<6} total={stats['total']:<3} alive={stats['alive']:<3} dead={stats['dead']:<3}")

    # Классификация
    print(f"\n  Классификация: {r.get('classification', {})}")

    # Результаты
    print(f"\n  Попыток: {r['claims_attempted']} | Успешных: {r['claims_success']} | "
          f"API обнаружено: {r.get('api_discoveries', 0)} | Sats: {r['total_sats_claimed']}")

    if r.get("claims"):
        print(f"\n  Результаты клеймов:")
        for c in r["claims"]:
            fid = c.get("faucet_id", "?")
            st = c.get("status", "?")
            http = c.get("http_status", 0)
            msg = str(c.get("message", ""))[:40]
            ct = c.get("claim_type", "")
            print(f"    [{ct:<8}] {fid:<28} HTTP {http:<4} {st} — {msg}")

    print(f"{'='*65}\n")


# ============================================================
# MAIN
# ============================================================

def run_batch(config: Dict, coins: Optional[List[str]] = None,
              include_testnet: bool = False, batch_size: int = 5,
              aggressive: bool = False) -> Dict:
    """Один полный батч: filter → probe → solve → claim → report."""
    batch_start = time.time()

    # Phase 0: Filter
    all_faucets = load_catalog()
    faucets = filter_faucets(all_faucets, coins=coins,
                             include_testnet=include_testnet,
                             max_priority=4 if aggressive else 3)

    if not faucets:
        log.warning("Нет кранов для обработки после фильтрации!")
        return {"ts": utc_now(), "probed": 0, "claims_attempted": 0,
                "claims_success": 0, "total_sats_claimed": 0, "claims": []}

    log.info(f"Отфильтровано: {len(faucets)} кранов (из {len(all_faucets)})")

    # Phase 1: Probe (всегда параллельно)
    probes = phase_probe(faucets, max_workers=min(len(faucets), 15))

    # Phase 2: Solve (параллельно, с бюджетным контролем)
    t_solve = time.time()
    tokens = phase_solve(probes, config, max_workers=min(batch_size, 5),
                         aggressive=aggressive)
    solve_time = time.time() - t_solve

    # Phase 3: Claim (параллельно)
    claims = phase_claim(probes, tokens, max_workers=min(batch_size, 10))

    # Phase 4: Report
    report = phase_report(probes, claims, solve_time)

    batch_time = time.time() - batch_start
    log.info(f"Батч завершён за {batch_time:.0f}s")

    return report


def main():
    import argparse
    ap = argparse.ArgumentParser(description="Multi-currency parallel batch faucet runner v2")
    ap.add_argument("--coins", type=str, default="", help="Comma-separated coins: BTC,DOGE,LTC")
    ap.add_argument("--include-testnet", action="store_true", help="Include testnet/devnet faucets")
    ap.add_argument("--loop", action="store_true", help="Бесконечный цикл")
    ap.add_argument("--interval", type=int, default=30, help="Интервал между батчами (мин)")
    ap.add_argument("--batch-size", type=int, default=5, help="Размер батча (workers)")
    ap.add_argument("--aggressive", action="store_true", help="Игнорировать бюджет, max_priority=4")
    ap.add_argument("--json", action="store_true", help="JSON output")
    ap.add_argument("--once-only", action="store_true", help="Выйти если нечего делать")
    args = ap.parse_args()

    coins = [c.strip().upper() for c in args.coins.split(",") if c.strip()] if args.coins else None
    config = load_config()

    run_count = 0
    while True:
        run_count += 1
        log.info(f"\n{'#'*65}")
        log.info(f"  BATCH #{run_count} | coins={coins or 'ALL'} | "
                 f"testnet={args.include_testnet} | batch_size={args.batch_size}")
        log.info(f"{'#'*65}")

        report = run_batch(
            config, coins=coins, include_testnet=args.include_testnet,
            batch_size=args.batch_size, aggressive=args.aggressive,
        )

        if args.json:
            print(json.dumps(report, indent=2, ensure_ascii=False))
        else:
            print_report(report)

        # Проверить: есть ли что делать
        solvable = report.get("classification", {}).get("captcha_solvable", 0)
        claimable = report.get("classification", {}).get("claimable", 0)
        investigate = report.get("classification", {}).get("needs_investigation", 0)

        if args.once_only and solvable == 0 and claimable == 0 and investigate == 0:
            log.info("Нечего делать. Выход (--once-only).")
            break

        if not args.loop:
            break

        interval = args.interval * 60
        log.info(f"Следующий батч через {args.interval} мин...")
        time.sleep(interval)


if __name__ == "__main__":
    raise SystemExit(main())
