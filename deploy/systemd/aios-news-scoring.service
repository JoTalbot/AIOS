[Unit]
Description=AIOS historical news sentiment scoring (resume-safe)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/AIOS
Environment=PYTHONPATH=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python -u /root/AIOS/scripts/score_historical_sentiment.py --batch-limit 400

[Install]
WantedBy=multi-user.target
