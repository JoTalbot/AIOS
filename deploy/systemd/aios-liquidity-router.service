[Unit]
Description=AIOS Smart Liquidity Router v20 - cross-chain yield scan (Polygon/Base/Arbitrum/Solana) + dry-run rebalance
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/AIOS
Environment=PYTHONPATH=/root/AIOS
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/aios/.venv/bin/python -u /root/AIOS/run_smart_liquidity_router.py --daemon --interval 3600
Restart=always
RestartSec=20

[Install]
WantedBy=multi-user.target
