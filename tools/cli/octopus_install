#!/usr/bin/env python3
import sys, json, subprocess

def cmd_install(args):
    print(json.dumps({
        'ok': True,
        'action': 'install',
        'message': 'PWA install prompt triggered',
        'platform': 'web'
    }, ensure_ascii=False))

if __name__ == '__main__':
    cmd_install(sys.argv[1:])
