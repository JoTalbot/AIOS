[Unit]
Description=Render redacted AIOS Telegram Prometheus snapshot
After=local-fs.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python -u /root/AIOS/scripts/telegram_metrics_snapshot.py --output /var/lib/aios-telegram-metrics/metrics.prom --interval 10
Restart=always
RestartSec=3
StateDirectory=aios-telegram-metrics
StateDirectoryMode=0755
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/root/AIOS/data -/var/lib/aios-alert-canary
ReadWritePaths=/var/lib/aios-telegram-metrics
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
