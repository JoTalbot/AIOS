@app.post('/lead')
def create_lead(r:LeadReq, request:Request):
    if r.website: return {'ok':True,'status':'received'}
    services={x.get('id'):x for x in SERVICE_CATALOG.get('services',[])}
    if r.service_id not in services: raise HTTPException(400,'unknown service_id')
    old=_existing_lead(r.idempotency_key)
    if old:return {'ok':True,'status':old.get('status'),'lead_id':old.get('lead_id'),'idempotent':True}
    ip=request.client.host if request.client else 'unknown'; ip_hash=hashlib.sha256(ip.encode()).hexdigest()[:24]
    if _lead_count_today(ip_hash)>=5: raise HTTPException(429,'daily lead limit exceeded')
    lead_id='lead_'+hashlib.sha256((r.idempotency_key+r.contact).encode()).hexdigest()[:20]
    item={'lead_id':lead_id,'created_at':datetime.now(timezone.utc).isoformat(),'service_id':r.service_id,'contact':r.contact,'requirements':r.requirements,'budget_usd':r.budget_usd,'idempotency_key':r.idempotency_key,'ip_hash':ip_hash,'status':'awaiting_review','payment_status':'pending','auto_execute':False}
    DATA.mkdir(parents=True,exist_ok=True)
    with open(LEADS,'a') as f:
        fcntl.flock(f.fileno(),fcntl.LOCK_EX); f.write(json.dumps(item,ensure_ascii=False)+'\n'); f.flush(); os.fsync(f.fileno()); fcntl.flock(f.fileno(),fcntl.LOCK_UN)
    return {'ok':True,'status':'awaiting_review','lead_id':lead_id,'quoted_price_usd':services[r.service_id].get('price_usd'),'auto_execute':False}


class UrlReq(BaseModel): url:str; timeout_sec:int=Field(default=10,ge=1,le=30)
class DomainReq(BaseModel): domain:str; port:int=Field(default=443,ge=1,le=65535); timeout_sec:int=Field(default=10,ge=1,le=30)
class WebhookReq(BaseModel): payload:dict[str,Any]; mapping:dict[str,str]={}
class CronReq(BaseModel): last_run_iso:str; max_age_sec:int=Field(default=3600,ge=1,le=604800)
class TextReq(BaseModel): text:str=Field(min_length=1,max_length=200000)
class GithubReq(BaseModel): repository:str; limit:int=Field(default=20,ge=1,le=100)
class AlertReq(BaseModel): message:str=Field(min_length=1,max_length=4000); dry_run:bool=True
