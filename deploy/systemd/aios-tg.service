[Unit]
Description=AIOS Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aios-telegram
Group=aios-telegram
WorkingDirectory=/root/AIOS
EnvironmentFile=-/root/AIOS/.env
LoadCredential=telegram_token:/etc/aios/credentials/telegram_token
LoadCredential=telegram_queue_key:/etc/aios/credentials/telegram_queue_key
LoadCredential=telegram_owner_chat_id:/etc/aios/credentials/telegram_owner_chat_id
Environment=AIOS_TELEGRAM_STATE_DIR=/var/lib/aios/telegram
Environment=AIOS_TELEGRAM_LOG_DIR=/var/log/aios/telegram
Environment=AIOS_TELEGRAM_BACKUP_DIR=/var/backups/aios/telegram-queues
Environment=HOME=/var/lib/aios/telegram
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TELEGRAM_PROMETHEUS_ENABLED=0
ExecStart=/usr/bin/python3 -u /root/AIOS/run_telegram_bot.py
Restart=always
RestartSec=5
TimeoutStopSec=110
KillSignal=SIGTERM
UMask=0077
StandardOutput=append:/var/log/aios/telegram/tg.log
StandardError=append:/var/log/aios/telegram/tg.log
NoNewPrivileges=true
PrivateTmp=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectProc=invisible

[Install]
WantedBy=multi-user.target
