[Unit]
Description=AIOS Treasury Audit & DeFi Reinvestment Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python /root/AIOS/run_treasury_manager.py --audit --rates
StandardOutput=append:/root/AIOS/logs/treasury_manager.log
StandardError=append:/root/AIOS/logs/treasury_manager.log
