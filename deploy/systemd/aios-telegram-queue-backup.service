[Unit]
Description=WAL-safe backup of encrypted AIOS Telegram queues
After=local-fs.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python /root/AIOS/scripts/telegram_queue_backup.py --keep-days 30
UMask=0077
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/root/AIOS/data /etc/aios/credentials
ReadWritePaths=/root/AIOS/backups /root/aios-secret-backups
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
