#!/usr/bin/env python3
from __future__ import annotations
import concurrent.futures, subprocess, json, time
from pathlib import Path
from datetime import datetime, timezone
B=Path('/root/agents/-Octopus/skills/core/money-earner-orchestrator'); C=B/'code'; D=B/'data'

def run(name,cmd,timeout=180):
 t=time.time()
 try:
  p=subprocess.run(cmd,cwd=B,capture_output=True,text=True,timeout=timeout)
  return {'name':name,'ok':p.returncode==0,'code':p.returncode,'duration_s':round(time.time()-t,2),'stdout':p.stdout[-3000:],'stderr':p.stderr[-1500:]}
 except Exception as e:return {'name':name,'ok':False,'code':-1,'duration_s':round(time.time()-t,2),'error':str(e)[:300]}

waves=[]
wave1={
 'public_endpoint':['/usr/bin/python3',str(C/'income_public_endpoint_monitor.py')],
 'storefront_health':['/usr/bin/python3',str(C/'income_storefront_health.py')],
 'sales_status':['/usr/bin/python3',str(C/'income_sales_status.py')],
 'income_bounded_health':['/usr/bin/python3',str(C/'income_bounded_health.py')],
 'octopus_runtime_health':['/usr/bin/python3',str(C/'octopus_runtime_health.py')],
 'memory_durability_health':['/usr/bin/python3',str(C/'memory_durability_health.py')],
 'skill_duplicate_health':['/usr/bin/python3',str(C/'skill_duplicate_health.py')],
 'skill_index_check':['/usr/bin/python3',str(C/'skill_index_rebuilder.py'),'--check'],
 'customer_status':['/usr/bin/python3',str(C/'income_customer_pipeline_status.py')],
 'currency_ledger':['/usr/bin/python3',str(C/'currency_ledger.py')],
 'source_roi':['/usr/bin/python3',str(C/'source_roi_gate.py')],
 'opportunities':['/usr/bin/python3',str(C/'opportunity_aggregate_runner.py')],
 'external_publication_reconcile':['/usr/bin/python3',str(C/'external_publication_reconcile.py')],
 'traff_project_health':['/usr/bin/python3','/root/agents/projects/traff/code/traff_octopus_bridge.py','status'],
 'self_sufficiency':['/usr/bin/python3',str(C/'self_sufficiency_status.py')],
}
with concurrent.futures.ThreadPoolExecutor(max_workers=8) as ex:
 fs={ex.submit(run,n,c,220):n for n,c in wave1.items()}; r1=[f.result() for f in concurrent.futures.as_completed(fs)]
waves.append({'wave':1,'mode':'parallel','results':r1,'ok':all(x['ok'] for x in r1)})
# Dependent summaries run only after source reports are refreshed.
r1b=[run('daily_summary',['/usr/bin/python3',str(C/'daily_summary.py')],180)]
waves.append({'wave':'1b','mode':'dependency_barrier','results':r1b,'ok':all(x['ok'] for x in r1b)})

wave2={
 'customer_key_issuer':['/usr/bin/python3',str(C/'income_api_key_issuer.py')],
 'pages_sync':['/usr/bin/python3',str(C/'sync_income_pages.py')],
 'captcha_audit':['/usr/bin/python3',str(C/'captcha_budget_audit.py')],
 'service_pipeline':['/usr/bin/python3',str(C/'service_pipeline.py')],
 'bounded_adaptation_proposals':['/usr/bin/python3',str(C/'bounded_adaptation_proposals.py')],
}
with concurrent.futures.ThreadPoolExecutor(max_workers=4) as ex:
 fs={ex.submit(run,n,c,180):n for n,c in wave2.items()}; r2=[f.result() for f in concurrent.futures.as_completed(fs)]
waves.append({'wave':2,'mode':'parallel_local','results':r2,'ok':all(x['ok'] for x in r2)})
r2b=[run('bounded_proposal_health',['/usr/bin/python3',str(C/'bounded_proposal_health.py')],90)]
waves.append({'wave':'2b','mode':'dependency_barrier','results':r2b,'ok':all(x['ok'] for x in r2b)})

# External side effects are intentionally serialized through the global lock wrapper.
external=[]
for name,cmd in [
 ('own_publication',[str(C/'with_external_effect_lock.sh'),'/usr/bin/python3',str(C/'external_offer_publisher.py')]),
 ('third_party_publication',[str(C/'with_external_effect_lock.sh'),'/usr/bin/python3',str(C/'third_party_bounty_publisher.py')]),
]: external.append(run(name,cmd,180))
waves.append({'wave':3,'mode':'serialized_global_lock','results':external,'ok':all(x['ok'] for x in external)})

out={'generated_at':datetime.now(timezone.utc).isoformat(),'mode':'all_vectors_batch_of_parallel_waves','workers':8,'waves':waves,'ok':all(w['ok'] for w in waves)}
D.mkdir(parents=True,exist_ok=True); (D/'all_vectors_latest.json').write_text(json.dumps(out,ensure_ascii=False,indent=2)+'\n')
print(json.dumps({'ok':out['ok'],'waves':[{'wave':w['wave'],'ok':w['ok'],'mode':w['mode'],'tasks':len(w['results'])} for w in waves]},ensure_ascii=False))
