{
  "annotations": {"list": []},
  "editable": true,
  "panels": [
    {
      "type": "stat",
      "title": "Total uploads",
      "targets": [{"expr": "octopus_ingest_uploads_total", "refId": "A"}],
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}
    },
    {
      "type": "stat",
      "title": "Total bytes",
      "targets": [{"expr": "octopus_ingest_bytes_total", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}
    },
    {
      "type": "stat",
      "title": "Transcriptions done",
      "targets": [{"expr": "octopus_whisper_done_total", "refId": "A"}],
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}
    },
    {
      "type": "stat",
      "title": "Avg whisper ms",
      "targets": [{"expr": "octopus_whisper_avg_ms", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ms"}},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Uploads rate (per minute)",
      "targets": [{"expr": "rate(octopus_ingest_uploads_total[5m])*60", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}
    },
    {
      "type": "timeseries",
      "title": "Whisper queue depth",
      "targets": [{"expr": "octopus_whisper_pending", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}
    },
    {
      "type": "stat",
      "title": "CAS coverage",
      "targets": [{"expr": "octopus_ingest_cas_pushed_total / octopus_ingest_uploads_total", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "green", "value": 0.95}]}}},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 12}
    },
    {
      "type": "stat",
      "title": "Forwarded coverage",
      "targets": [{"expr": "octopus_ingest_forwarded_total / octopus_ingest_uploads_total", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit"}},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 12}
    },
    {
      "type": "stat",
      "title": "Whisper failure rate",
      "targets": [{"expr": "octopus_whisper_failed_total / (octopus_whisper_done_total + octopus_whisper_failed_total + 1)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 0.05}, {"color": "red", "value": 0.20}]}}},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 12}
    },
    {
      "type": "stat",
      "title": "Folders",
      "targets": [{"expr": "octopus_ingest_folders", "refId": "A"}],
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 12}
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "title": "Octopus Ingest + Whisper",
  "tags": ["octopus", "audio", "ingest", "whisper"],
  "timezone": "browser",
  "time": {"from": "now-6h", "to": "now"},
  "uid": "octopus-ingest-v1"
}
