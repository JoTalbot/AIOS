[Unit]
Description=AIOS T2 momentum paper loop (BTC & ETH close vs SMA50, daily signal + TG)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/AIOS
Environment=PYTHONPATH=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python -u /root/AIOS/scripts/run_t2_momentum.py --symbol BTC-USD --notify
ExecStart=/opt/aios/.venv/bin/python -u /root/AIOS/scripts/run_t2_momentum.py --symbol ETH-USD --notify

[Install]
WantedBy=multi-user.target
