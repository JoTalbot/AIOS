[Unit]
Description=AIOS OLX Price Alerts
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python /root/AIOS/run_olx_price_alerts.py
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/aios/aios-telegram-bot.env
StandardOutput=append:/root/AIOS/logs/olx_price.log
StandardError=append:/root/AIOS/logs/olx_price.log
