#!/usr/bin/env python3
"""stakely_claimer.py — Stakely.io faucet Playwright claimer.

Stakely: Vue.js SPA + Cloudflare Turnstile.
Strategy: commit navigation + wait for selectors (no networkidle).

Usage:
  python3 stakely_claimer.py --coin polygon-pol
  python3 stakely_claimer.py --all
  python3 stakely_claimer.py --loop --interval 600
"""

import argparse, json, logging, os, sys, time, re
from datetime import datetime, timezone
from pathlib import Path

try:
    from playwright.sync_api import sync_playwright, TimeoutError as PlaywrightTimeout
except ImportError:
    print("ERROR: playwright not installed"); sys.exit(1)

SKILL_DIR = Path(os.environ.get("OCTOPUS_ME_SKILL_DIR") or Path(__file__).resolve().parents[1])
CONFIG = SKILL_DIR / "config"
DATA = SKILL_DIR / "data"
FAUCET_CFG = CONFIG / "faucet_config.json"
LEDGER = DATA / "faucet_ledger.json"
COOLDOWN_FILE = DATA / "faucet_cooldowns.json"

logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(message)s", datefmt="%H:%M:%S")
log = logging.getLogger("stakely")

STAKELY_FAUCETS = {
    "polygon-pol": {"url": "https://stakely.io/faucet/polygon-pol", "coin": "POL"},
    "bnb": {"url": "https://stakely.io/faucet/bnb", "coin": "BNB"},
    "arbitrum": {"url": "https://stakely.io/faucet/arbitrum", "coin": "ARB"},
    "base": {"url": "https://stakely.io/faucet/base", "coin": "BASE"},
}

def load_json(p, d=None):
    try:
        data = json.loads(p.read_text(encoding="utf-8"))
        if d and isinstance(d, dict) and isinstance(data, dict):
            for k,v in d.items():
                if k not in data: data[k] = v
            return data
        return data
    except: return d if d else {}

def save_json(p, d):
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(json.dumps(d, indent=2, ensure_ascii=False), encoding="utf-8")

def utc_now(): return datetime.now(timezone.utc).isoformat()

def claim_stakely(faucet_key, fdef, address, headless=True):
    url = fdef["url"]
    coin = fdef["coin"]
    fid = f"stakely-{faucet_key}"
    result = {"faucet_id": fid, "coin": coin, "url": url, "status": "unknown",
              "amount": "0", "message": "", "timestamp": utc_now()}

    browser = None
    try:
        with sync_playwright() as p:
            browser = p.chromium.launch(
                headless=headless,
                args=["--no-sandbox", "--disable-blink-features=AutomationControlled", "--disable-dev-shm-usage"],
            )
            ctx = browser.new_context(
                user_agent="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36",
                viewport={"width": 1920, "height": 1080},
            )
            page = ctx.new_page()

            # Navigate with commit (don't wait for anything)
            log.info(f"[{coin}] Loading {url} (commit mode)...")
            page.goto(url, wait_until="commit", timeout=30000)

            # Wait for Vue app to render — look for address input
            log.info(f"[{coin}] Waiting for address input...")
            try:
                page.wait_for_selector(".v-field__input", timeout=60000)
                log.info(f"[{coin}] Address input found!")
            except PlaywrightTimeout:
                # Try alternative selectors
                found = False
                for sel in ["input[type='text']", "input[aria-label]", "#address", "input[name='address']"]:
                    try:
                        el = page.query_selector(sel)
                        if el:
                            el.wait_for_element_state("visible", timeout=5000)
                            log.info(f"[{coin}] Found input via: {sel}")
                            found = True
                            break
                    except: continue
                if not found:
                    result["status"] = "timeout"
                    result["message"] = "No address input found after 65s"
                    log.error(f"[{coin}] No address input!")
                    # Save HTML for debug
                    try:
                        with open(f"/tmp/stakely_{coin}_{int(time.time())}.html", "w") as f:
                            f.write(page.content())
                    except: pass
                    browser.close()
                    return result

            time.sleep(2)
            html = page.content()

            # Detect Turnstile
            has_turnstile = "turnstile" in html.lower()
            log.info(f"[{coin}] Turnstile: {'YES' if has_turnstile else 'NO'}")

            # Fill address
            addr_input = page.query_selector(".v-field__input")
            if addr_input:
                addr_input.fill(address)
                log.info(f"[{coin}] Address filled: {address[:20]}...")
                time.sleep(0.5)

            # Check checkboxes (terms/conditions)
            for checkbox in page.query_selector_all("input[type='checkbox']"):
                try:
                    if not checkbox.is_checked():
                        checkbox.check()
                        log.info(f"[{coin}] Checked checkbox")
                except: pass

            # Wait for Turnstile to auto-solve (Cloudflare often auto-solves in headless)
            if has_turnstile:
                log.info(f"[{coin}] Waiting for Turnstile auto-solve (up to 30s)...")
                try:
                    # Wait for turnstile response to appear
                    page.wait_for_selector(
                        "input[name='cf-turnstile-response'][value!=''], .cf-turnstile-response",
                        timeout=30000
                    )
                    log.info(f"[{coin}] Turnstile appears solved!")
                except PlaywrightTimeout:
                    log.warning(f"[{coin}] Turnstile may not have solved")
                except Exception as e:
                    log.warning(f"[{coin}] Turnstile check error: {e}")

            # Find and click submit button
            submit_selectors = [
                "button.single-button",
                "button.v-btn--variant-flat.bg-whiteb",
                "button:has-text('Send')",
                "button:has-text('Claim')",
                "button:has-text('Get')",
                "button:has-text('Receive')",
                "button:has-text('Faucet')",
            ]

            clicked = False
            for sel in submit_selectors:
                try:
                    el = page.query_selector(sel)
                    if el and el.is_visible():
                        txt = (el.inner_text() or "").strip()[:50]
                        log.info(f"[{coin}] Clicking: '{txt}' via {sel}")
                        el.click()
                        clicked = True
                        break
                except: continue

            if not clicked:
                # Try any visible non-disabled button
                try:
                    btns = page.query_selector_all("button.v-btn")
                    for btn in btns:
                        try:
                            if btn.is_visible() and not btn.is_disabled():
                                txt = (btn.inner_text() or "").strip()[:50]
                                if txt and txt not in ["en", "Staking Networks", "Products", "Resources"]:
                                    log.info(f"[{coin}] Clicking visible button: '{txt}'")
                                    btn.click()
                                    clicked = True
                                    break
                        except: continue
                except: pass

            if clicked:
                # Wait for response
                log.info(f"[{coin}] Waiting for response...")
                time.sleep(5)
                try:
                    page.wait_for_load_state("domcontentloaded", timeout=10000)
                except: pass

                post_html = page.content()

                # Save for debug
                try:
                    with open(f"/tmp/stakely_{coin}_post_{int(time.time())}.html", "w") as f:
                        f.write(post_html)
                    page.screenshot(path=f"/tmp/stakely_{coin}_{int(time.time())}.png", full_page=True)
                except: pass

                combined = post_html.lower()

                # Check for success
                if any(k in combined for k in ["sent", "success", "transaction", "tx hash", "explorer", "received"]):
                    # Extract tx hash
                    tx = ""
                    tx_m = re.search(r"0x[a-fA-F0-9]{40,64}", post_html)
                    if tx_m:
                        tx = tx_m.group(0)
                    result["status"] = "claimed"
                    result["amount"] = "gas tokens"
                    result["message"] = f"tx={tx[:30]}..." if tx else "Success detected"
                    log.info(f"[{coin}] CLAIMED! {result['message']}")
                elif any(k in combined for k in ["rate limit", "already claimed", "try again later", "too many", "cooldown"]):
                    result["status"] = "rate_limited"
                    result["message"] = "Rate limited / cooldown"
                    log.warning(f"[{coin}] Rate limited")
                elif any(k in combined for k in ["invalid", "wrong address", "incorrect"]):
                    result["status"] = "error"
                    result["message"] = "Invalid address"
                    log.warning(f"[{coin}] Invalid address?")
                else:
                    result["status"] = "clicked_unknown"
                    result["message"] = "Clicked, unclear result"
                    log.info(f"[{coin}] Clicked, unclear")

                    # Print visible text for analysis
                    try:
                        body = page.evaluate("() => document.body ? document.body.innerText.substring(0, 2000) : ''")
                        if body:
                            log.info(f"[{coin}] Page text: {body[:500]}")
                    except: pass
            else:
                result["status"] = "no_button"
                result["message"] = "No submit button"
                log.warning(f"[{coin}] No submit button")

            browser.close()
            browser = None

    except PlaywrightTimeout as e:
        result["status"] = "timeout"
        result["message"] = str(e)[:200]
    except Exception as e:
        result["status"] = "exception"
        result["message"] = str(e)[:200]
        log.error(f"[{coin}] Exception: {e}")
    finally:
        try:
            if browser: browser.close()
        except: pass

    # Save cooldown
    try:
        cd = load_json(COOLDOWN_FILE, {"cooldowns": {}})
        cd.setdefault("cooldowns", {})[fid] = utc_now()
        save_json(COOLDOWN_FILE, cd)
    except: pass

    # Save ledger
    try:
        ledger = load_json(LEDGER, {"claims": []})
        ledger.setdefault("claims", []).append({
            "ts": utc_now(), "faucet_id": fid, "coin": coin,
            "amount": result.get("amount", "0"), "status": result["status"],
            "details": result.get("message", ""),
        })
        ledger["claims"] = ledger["claims"][-500:]
        save_json(LEDGER, ledger)
    except: pass

    return result


def main():
    parser = argparse.ArgumentParser(description="Stakely.io Faucet Claimer")
    parser.add_argument("--coin", type=str, default=None, help="Faucet key (e.g., polygon-pol)")
    parser.add_argument("--all", action="store_true", help="All Stakely faucets")
    parser.add_argument("--address", type=str, default="", help="Wallet address")
    parser.add_argument("--loop", action="store_true", help="Loop mode")
    parser.add_argument("--interval", type=int, default=600, help="Loop interval (s)")
    parser.add_argument("--headed", action="store_true", help="Visible browser")
    args = parser.parse_args()

    # Default: polygon-pol
    if args.all:
        targets = list(STAKELY_FAUCETS.items())
    elif args.coin:
        targets = [(args.coin, STAKELY_FAUCETS.get(args.coin, {"url": f"https://stakely.io/faucet/{args.coin}", "coin": args.coin.upper()}))]
    else:
        targets = [("polygon-pol", STAKELY_FAUCETS["polygon-pol"])]

    iteration = 0
    while True:
        iteration += 1
        log.info(f"{'='*60} ITERATION #{iteration} | {len(targets)} faucets {'='*60}")

        results = []
        for fk, fd in targets:
            log.info(f"\n{'─'*50} {fk} ({fd['coin']}) {'─'*50}")
            r = claim_stakely(fk, fd, args.address, headless=not args.headed)
            results.append(r)
            if fk != targets[-1][0]:
                time.sleep(10)

        # Summary
        print(f"\n{'='*65}")
        print(f"STAKELY RESULTS — #{iteration}")
        print(f"{'='*65}")
        for r in results:
            print(f"  {r['coin']:<6} {r['status']:<20} {r['message'][:40]}")
        print(f"{'='*65}\n")

        if not args.loop:
            break
        log.info(f"Sleeping {args.interval}s...")
        time.sleep(args.interval)

if __name__ == "__main__":
    main()
