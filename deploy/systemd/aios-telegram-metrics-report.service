[Unit]
Description=AIOS Telegram structured metrics thresholds and deduplicated alerts
After=network-online.target aios-telegram-bot.service aios-tg.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/AIOS
EnvironmentFile=-/root/AIOS/.env
EnvironmentFile=-/root/AIOS/data/.telegram_canary.env
LoadCredential=telegram_token:/etc/aios/credentials/telegram_token
LoadCredential=telegram_queue_key:/etc/aios/credentials/telegram_queue_key
Environment=TELEGRAM_QUEUE_KEY_FILE=%d/telegram_queue_key
ExecStart=/opt/aios/.venv/bin/python /root/AIOS/scripts/telegram_metrics_report.py
StandardOutput=append:/root/AIOS/logs/telegram_metrics_report.log
StandardError=append:/root/AIOS/logs/telegram_metrics_report.log
TimeoutStartSec=90
UMask=0077
Nice=10
