[Unit]
Description=AIOS Autonomous Digital Earnings - 100% цифровой мозг автономного заработка
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/AIOS
Environment=PYTHONPATH=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python -u /root/AIOS/run_autonomous_earnings.py --daemon --interval 3600
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
