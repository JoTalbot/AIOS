[Unit]
Description=AIOS Colab Farm Heartbeat & Service Registry Monitor
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/AIOS
Environment=PYTHONPATH=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python -u /root/AIOS/run_colab_heartbeat.py --daemon --interval 120 --stale 600
Restart=always
RestartSec=20

[Install]
WantedBy=multi-user.target
