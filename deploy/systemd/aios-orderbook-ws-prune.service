[Unit]
Description=AIOS Orderbook WS research DB retention prune (7d raw / 60d minute)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/AIOS
Environment=PYTHONPATH=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python -u /root/AIOS/scripts/prune_orderbook_ws.py --db /root/AIOS/data/quant/orderbooks.sqlite --raw-days 7 --keep-days 60
