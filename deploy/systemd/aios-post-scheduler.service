[Unit]
Description=AIOS Post Scheduler (очередь публикаций)
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python /root/AIOS/run_post_scheduler.py
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/aios/aios-telegram-bot.env
StandardOutput=append:/root/AIOS/logs/post_scheduler.log
StandardError=append:/root/AIOS/logs/post_scheduler.log
