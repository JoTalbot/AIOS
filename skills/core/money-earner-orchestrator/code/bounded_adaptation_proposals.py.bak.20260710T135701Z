#!/usr/bin/env python3
import json, shutil
from datetime import datetime, timezone
from pathlib import Path
R=Path('/root/agents/-Octopus'); M=R/'skills/core/money-earner-orchestrator'; D=M/'data'; P=R/'proposals'; P.mkdir(parents=True,exist_ok=True)
disk=shutil.disk_usage('/'); disk_pct=round(100*disk.used/disk.total,2)
runtime=json.loads((D/'octopus_runtime_health_latest.json').read_text()) if (D/'octopus_runtime_health_latest.json').exists() else {}
dups=json.loads((D/'skill_duplicate_health_latest.json').read_text()) if (D/'skill_duplicate_health_latest.json').exists() else {}
props=[]
if disk_pct>=70:
    props.append({'id':'disk_headroom','priority':'medium' if disk_pct<75 else 'high','trigger':f'disk={disk_pct}%','action':'run bounded cleanup audit and identify top reclaimable caches/logs','auto_apply':False,'rollback':'not_applicable_read_only_proposal'})
if not runtime.get('healthy',False):
    props.append({'id':'octopus_runtime','priority':'high','trigger':'runtime_health=false','action':'inspect only failed Octopus units; restart only with backup/validation','auto_apply':False})
for item in dups.get('items',[]):
    props.append({'id':'merge_duplicate_'+item['name'],'priority':'low','trigger':'duplicate_skill_name','canonical_candidate':item.get('canonical_candidate'),'duplicates':item.get('paths'),'action':'compare code/tests/references, merge unique content into canonical candidate, archive duplicate after explicit validation','auto_apply':False,'destructive_action_performed':False})
out={'generated_at':datetime.now(timezone.utc).isoformat(),'mode':'bounded_proposals_only','disk_used_percent':disk_pct,'proposal_count':len(props),'proposals':props,'external_actions_performed':False}
(D/'bounded_adaptation_proposals_latest.json').write_text(json.dumps(out,ensure_ascii=False,indent=2)+'\n')
md=P/(datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')+'_bounded_adaptation_proposals.md')
md.write_text('# Bounded adaptation proposals\n\n'+''.join(f"## {p['id']}\n\n```json\n{json.dumps(p,ensure_ascii=False,indent=2)}\n```\n\n" for p in props))
print(json.dumps({'proposal_count':len(props),'disk_used_percent':disk_pct,'proposal_file':str(md)},ensure_ascii=False))
