#!/usr/bin/env python3
"""faucet_batch_runner_v2.py — MULTI-CURRENCY параллельный батчевый раннер.

Поддерживаемые монеты: BTC (LN + on-chain), LTC, DOGE, BCH, DASH, TRX, POL, SOL, XRP
Архитектура:
  Phase 0 — FILTER: отфильтровать mainnet краны по приоритету и живости
  Phase 1 — PROBE: параллельная проверка живости + обнаружение sitekey
  Phase 2 — SOLVE: параллельное решение капч (hCaptcha/reCAPTCHA/Turnstile)
  Phase 3 — CLAIM: параллельный клейм через все известные API
  Phase 4 — REPORT: агрегация, ledger, статистика по монетам

Запуск:
  python3 faucet_batch_runner_v2.py                  # один батч, все mainnet
  python3 faucet_batch_runner_v2.py --coins BTC,DOGE # только BTC и DOGE
  python3 faucet_batch_runner_v2.py --loop --interval 20  # цикл каждые 20 мин
  python3 faucet_batch_runner_v2.py --loop --json    # JSON лог
  python3 faucet_batch_runner_v2.py --include-testnet  # + testnet краны
  python3 faucet_batch_runner_v2.py --batch-size 8   # размер батча (default 5)
  python3 faucet_batch_runner_v2.py --aggressive     # игнорировать бюджет, max workers
"""
