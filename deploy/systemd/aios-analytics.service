[Unit]
Description=AIOS Analytics Snapshot (подписчики IG/TT, OLX)
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python /root/AIOS/run_analytics_snapshot.py
Environment=PYTHONUNBUFFERED=1
StandardOutput=append:/root/AIOS/logs/analytics.log
StandardError=append:/root/AIOS/logs/analytics.log
