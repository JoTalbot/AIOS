[Unit]
Description=AIOS Converge Harvester — автоподгрузка 50+ сообщений при новом входящем
After=network.target aios-viber-desktop.service aios-signal-desktop.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python /root/AIOS/run_converge_harvester.py
StandardOutput=append:/root/AIOS/logs/converge_harvester.log
StandardError=append:/root/AIOS/logs/converge_harvester.log
TimeoutSec=180

[Install]
WantedBy=multi-user.target
