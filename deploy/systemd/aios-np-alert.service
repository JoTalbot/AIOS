[Unit]
Description=AIOS Nova Poshta parcel alerts
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python /root/AIOS/run_np_alerts.py
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/aios/aios-telegram-bot.env
StandardOutput=append:/root/AIOS/logs/np_alerts.log
StandardError=append:/root/AIOS/logs/np_alerts.log
