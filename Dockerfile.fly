# Облегчённый образ AIOS для Fly.io Free Trial.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=8000

WORKDIR /app

RUN addgroup --system aios && adduser --system --ingroup aios aios

COPY requirements-fly.txt ./
RUN pip install --upgrade pip && pip install -r requirements-fly.txt

# Для trial-узла копируем только код, необходимый HTTP API и LLM-рою.
# Полный aios_core/__init__.py зависит от десятков production-модулей, поэтому
# здесь используется namespace package без него.
RUN mkdir -p /app/aios_core
COPY --chown=aios:aios aios_core/p2p_network.py /app/aios_core/p2p_network.py
COPY --chown=aios:aios aios_core/llm_swarm_debate.py /app/aios_core/llm_swarm_debate.py

USER aios

EXPOSE 8000

CMD ["uvicorn", "aios_core.p2p_network:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers"]
