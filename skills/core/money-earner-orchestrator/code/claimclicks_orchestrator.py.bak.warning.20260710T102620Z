# ─── Helpers ─────────────────────────────────────────────

def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat()


def load_json(path: Path, default: Any = None) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return default if default is not None else {}


def save_json(path: Path, data: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2, ensure_ascii=False), encoding="utf-8")




def parse_number_tokens(text: str) -> List[int]:
    """Parse numeric tokens including simple English number words."""
    words = {
        "zero": 0, "one": 1, "two": 2, "three": 3, "four": 4,
        "five": 5, "six": 6, "seven": 7, "eight": 8, "nine": 9,
        "ten": 10,
    }
    tokens = re.findall(r"[A-Za-z]+|\d+", (text or "").lower())
    out: List[int] = []
    for token in tokens:
        if token.isdigit():
            out.append(int(token))
        elif token in words:
            out.append(words[token])
    return out

def is_on_cooldown(fid: str, min_minutes: int = 3) -> bool:
    cds = load_json(COOLDOWN_FILE, {"cooldowns": {}})
    last = cds.get("cooldowns", {}).get(fid)
    if not last:
        return False
    try:
        elapsed = (datetime.now(timezone.utc) - datetime.fromisoformat(last)).total_seconds() / 60
        return elapsed < min_minutes
    except (ValueError, TypeError):
        return False


def set_cooldown(fid: str) -> None:
    cds = load_json(COOLDOWN_FILE, {"cooldowns": {}})
    if "cooldowns" not in cds:
        cds["cooldowns"] = {}
    cds["cooldowns"][fid] = utc_now()
    save_json(COOLDOWN_FILE, cds)


def captcha_budget_state() -> dict:
    today = datetime.now(timezone.utc).strftime("%Y-%m-%d")
    state = load_json(BUDGET_FILE, {"date": today, "spent_usd": 0.0, "solves": 0})
    if state.get("date") != today:
        state = {"date": today, "spent_usd": 0.0, "solves": 0}
    cfg = load_json(FAUCET_CFG, {})
    state["max_daily_budget_usd"] = float(cfg.get("captcha", {}).get("max_daily_budget_usd", 0.5))
    return state


def reserve_image_captcha() -> bool:
    global _RUN_IMAGE_SOLVES
    cfg = load_json(FAUCET_CFG, {})
    if not cfg.get("captcha", {}).get("auto_paid_enabled", False):
        log.warning("Paid CAPTCHA disabled by config")
        return False
    state = captcha_budget_state()
    if _RUN_IMAGE_SOLVES >= MAX_IMAGE_CAPTCHAS_PER_RUN:
        log.warning("Image CAPTCHA run limit reached")
        return False
    if state.get("spent_usd", 0.0) + IMAGE_CAPTCHA_COST_USD > state["max_daily_budget_usd"]:
        log.warning("Daily CAPTCHA budget would be exceeded")
        return False
    return True


def record_image_captcha_spend() -> None:
    global _RUN_IMAGE_SOLVES
    atomic_record_spend(BUDGET_FILE, IMAGE_CAPTCHA_COST_USD, source='claimclicks_orchestrator.py')
    _RUN_IMAGE_SOLVES += 1

def append_ledger(coin: str, faucet_id: str, amount: str, status: str, details: str = ""):
    ledger = load_json(LEDGER, {"claims": []})
    if "claims" not in ledger:
        ledger["claims"] = []
    ledger["claims"].append({
        "ts": utc_now(), "faucet_id": faucet_id, "coin": coin,
        "amount": amount, "status": status, "details": details,
    })
    ledger["claims"] = ledger["claims"][-500:]
    save_json(LEDGER, ledger)


# ─── 2Captcha Image-to-Text ─────────────────────────────

def solve_image_captcha(api_key: str, base64_image: str, timeout: int = 60) -> Optional[str]:
    """Send image to 2Captcha for text recognition. Returns recognized text."""
    if not reserve_image_captcha():
        return None
    # Submit
    boundary = "----FormBoundary7MA4YWxkTrZu0gW"
    body = (
        f"--{boundary}\r\n"
        f'Content-Disposition: form-data; name="method"\r\n\r\nbase64\r\n'
        f"--{boundary}\r\n"
        f'Content-Disposition: form-data; name="key"\r\n\r\n{api_key}\r\n'
        f"--{boundary}\r\n"
        f'Content-Disposition: form-data; name="body"\r\n\r\n{base64_image}\r\n'
        f"--{boundary}\r\n"
        f'Content-Disposition: form-data; name="json"\r\n\r\n1\r\n'
        f"--{boundary}--\r\n"
    )
    req = urllib.request.Request(
        "https://api.2captcha.com/in.php",
        data=body.encode(),
        headers={"Content-Type": f"multipart/form-data; boundary={boundary}"},
    )
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            result = json.loads(resp.read().decode())
    except Exception as e:
        log.error(f"2Captcha submit error: {e}")
        return None

    if result.get("status") != 1:
        log.error(f"2Captcha submit failed: {result}")
        return None

    task_id = result["request"]
    log.info(f"2Captcha image task {task_id} submitted")

    # Poll
    for i in range(timeout // 5):
        time.sleep(5)
        try:
            url = f"https://api.2captcha.com/res.php?key={api_key}&action=get&id={task_id}&json=1"
            with urllib.request.urlopen(url, timeout=15) as resp:
                result = json.loads(resp.read().decode())
        except Exception as e:
            log.warning(f"2Captcha poll error: {e}")
            continue

        if result.get("status") == 1:
            text = result["request"]
            record_image_captcha_spend()
            log.info(f"2Captcha solved image: '{text}'")
            return text
        if result.get("request") != "CAPCHA_NOT_READY":
            log.warning(f"2Captcha error: {result}")
            return None

    log.warning("2Captcha image timeout")
    return None


# ─── Daemon Client ──────────────────────────────────────

class DaemonClient:
    """Communicates with claimclicks_daemon.py via stdin/stdout JSON."""

    def __init__(self, daemon_path: str):
        self.daemon_path = daemon_path
        self.proc: Optional[subprocess.Popen] = None
        self._cmd_id = 0

    def start(self) -> bool:
        try:
            self.proc = subprocess.Popen(
                [sys.executable, self.daemon_path],
                stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                text=True, bufsize=1,
            )
            # Read ready signal
            line = self.proc.stdout.readline().strip()
            if not line:
                log.error("Daemon did not send ready signal")
                return False
            ready = json.loads(line)
            if not ready.get("ok"):
                log.error(f"Daemon not ready: {ready}")
                return False
            log.info("Daemon started and ready")
            return True
        except Exception as e:
            log.error(f"Daemon start error: {e}")
            return False

    def send(self, cmd: str, params: Optional[Dict] = None) -> Dict[str, Any]:
        if not self.proc:
            return {"ok": False, "error": "daemon not running"}

        self._cmd_id += 1
        msg = {"id": self._cmd_id, "cmd": cmd}
        if params:
            msg["params"] = params

        try:
            self.proc.stdin.write(json.dumps(msg) + "\n")
            self.proc.stdin.flush()
            line = self.proc.stdout.readline().strip()
            if line:
                return json.loads(line)
            return {"ok": False, "error": "no response"}
        except Exception as e:
            return {"ok": False, "error": str(e)}

    def stop(self):
        if self.proc:
            try:
                self.send("quit")
                self.proc.wait(timeout=10)
            except Exception:
                self.proc.kill()
            self.proc = None


# ─── Main Claim Flow ────────────────────────────────────

def claim_one_coin(
    daemon: DaemonClient,
    coin: str,
    url: str,
    username: str,
    captcha_api_key: str,
    headless: bool = True,
) -> Dict[str, Any]:
    """Complete claim flow for one coin."""
    fid = f"claimclicks-{coin}"
    result = {
        "faucet_id": fid, "coin": coin, "url": url,
        "status": "unknown", "amount": "0", "message": "",
        "timestamp": utc_now(),
    }

    if is_on_cooldown(fid, min_minutes=3):
        result["status"] = "cooldown"
        result["message"] = "On cooldown (3 min)"
        log.info(f"[{coin.upper()}] On cooldown, skipping")
        return result

    t0 = time.time()

    try:
        # ── Step 1: Navigate ──
        log.info(f"[{coin.upper()}] Navigating to {url}")
        r = daemon.send("navigate", {"url": url, "timeout": 60000})
        if not r.get("ok"):
            result["status"] = "nav_error"
            result["message"] = r.get("error", "")[:200]
            log.error(f"[{coin.upper()}] Navigate failed: {result['message']}")
            return result
        time.sleep(2)

        # ── Step 2: Click "Claim Free BTC/DOGE/..." button ──
        coin_label = coin.upper()
        r = daemon.send("evaluate", {"js": f"""
            (function() {{
                const btns = document.querySelectorAll('button, a, input[type="submit"]');
                for (const btn of btns) {{
                    const t = btn.textContent.trim();
                    if (t.includes('Claim Free {coin_label}') || t.includes('Claim Free')) {{
                        btn.click();
                        return {{clicked: t.substring(0, 60)}};
                    }}
                }}
                return {{clicked: false}};
            }})()
        """})
        if r.get("ok") and r["data"].get("result", {}).get("clicked"):
            log.info(f"[{coin.upper()}] Clicked: {r['data']['result']['clicked']}")
        else:
            log.warning(f"[{coin.upper()}] Could not find/click claim button")
            result["status"] = "no_button"
            result["message"] = "Claim button not found"
            return result

        time.sleep(3)  # Wait for modal

        # ── Step 3: Fill the actual ClaimClicks FaucetPay username field ──
        r = daemon.send("evaluate", {"js": f"""
            (function() {{
                const candidates = [
                    document.querySelector('#fp-username-input'),
                    document.querySelector('input[placeholder="Enter Your FaucetPay Username"]'),
                    document.querySelector('input[placeholder="FaucetPay username"]')
                ].filter(Boolean);
                const el = candidates[0];
                if (!el) return {{filled:false, error:'FaucetPay username input not found'}};
                const setter = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set;
                setter.call(el, {__import__('json').dumps(username)});
                el.dispatchEvent(new Event('input', {{bubbles:true}}));
                el.dispatchEvent(new Event('change', {{bubbles:true}}));
                return {{filled: el.value === {__import__('json').dumps(username)}, id:el.id, name:el.name, value:el.value}};
            }})()
        """})
        fill_result = r.get("data", {}).get("result", {}) if r.get("ok") else {}
        if fill_result.get("filled"):
            log.info(f"[{coin.upper()}] FaucetPay username bound to form field")
        else:
            result["status"] = "username_error"
            result["message"] = fill_result.get("error", r.get("error", "Username fill failed"))
            log.error(f"[{coin.upper()}] Username fill failed: {result['message']}")
            return result

        # ── Step 4: Get anti-bot info ──
        log.info(f"[{coin.upper()}] Getting anti-bot info...")
        r = daemon.send("evaluate", {"js": """
            (function() {
                // Get order image (the one in the instruction paragraph)
                const orderImgs = document.querySelectorAll('.alert img, .alert-info img');
                let orderImgBase64 = '';
                for (const img of orderImgs) {
                    if (img.src && img.src.startsWith('data:image')) {
                        // Render at higher resolution
                        const c = document.createElement('canvas');
                        const scale = 8;
                        c.width = (img.naturalWidth || img.width || 200) * scale;
                        c.height = (img.naturalHeight || img.height || 40) * scale;
                        const ctx = c.getContext('2d');
                        ctx.imageSmoothingEnabled = false;
                        ctx.drawImage(img, 0, 0, c.width, c.height);
                        orderImgBase64 = c.toDataURL('image/png').split(',')[1];
                        break;
                    }
                }

                // Get anti-bot link images
                const links = document.querySelectorAll('.antibotlinks a');
                const linkData = [];
                links.forEach(function(a, i) {
                    const img = a.querySelector('img');
                    if (img) {
                        const c = document.createElement('canvas');
                        const scale = 8;
                        c.width = (img.naturalWidth || img.width || 50) * scale;
                        c.height = (img.naturalHeight || img.height || 38) * scale;
                        const ctx = c.getContext('2d');
                        ctx.imageSmoothingEnabled = false;
                        ctx.drawImage(img, 0, 0, c.width, c.height);
                        linkData.push({
                            index: i,
                            rel: a.getAttribute('rel'),
                            base64: c.toDataURL('image/png').split(',')[1],
                        });
                    }
                });

                return {
                    orderImgBase64: orderImgBase64,
                    linkData: linkData,
                    linkCount: links.length,
                };
            })()
        """})

        if not r.get("ok"):
            result["status"] = "antibot_error"
            result["message"] = f"Failed to get anti-bot info: {r.get('error', '')}"
            log.error(f"[{coin.upper()}] {result['message']}")
            return result

        ab_data = r["data"]["result"]
        order_img_b64 = ab_data.get("orderImgBase64", "")
        link_data = ab_data.get("linkData", [])
        link_count = ab_data.get("linkCount", 0)

        if not order_img_b64 or link_count < 2:
            log.warning(f"[{coin.upper()}] No order image or too few links ({link_count}), trying without anti-bot")
        else:
            # ── Step 5: Read order image via 2Captcha ──
            log.info(f"[{coin.upper()}] Reading order image via 2Captcha...")
            order_text = solve_image_captcha(captcha_api_key, order_img_b64)

            # ── Step 6: Read link images via 2Captcha ──
            link_numbers = {}
            for ld in link_data:
                log.info(f"[{coin.upper()}] Reading link {ld['index']} (rel={ld['rel']})...")
                num_text = solve_image_captcha(captcha_api_key, ld["base64"])
                if num_text:
                    # Extract numbers from the text
                    nums = parse_number_tokens(num_text)
                    if nums:
                        link_numbers[ld["index"]] = int(nums[0])
                        log.info(f"[{coin.upper()}] Link {ld['index']}: '{num_text}' -> number {link_numbers[ld['index']]}")
                    else:
                        log.warning(f"[{coin.upper()}] Link {ld['index']}: could not parse number from '{num_text}'")
                else:
                    log.warning(f"[{coin.upper()}] Link {ld['index']}: 2Captcha unavailable; no unsafe fallback")

            # ── Step 7: Determine click order ──
            if order_text:
                order_nums = parse_number_tokens(order_text)
                log.info(f"[{coin.upper()}] Order image: '{order_text}' -> sequence {order_nums}")

                # Map: for each number in order, find the link index that shows it
                click_order = []
                for target_num in order_nums:
                    found = False
                    for idx, shown_num in link_numbers.items():
                        if shown_num == target_num:
                            click_order.append(idx)
                            found = True
                            break
                    if not found:
                        log.warning(f"[{coin.upper()}] No link shows number {target_num}")

                log.info(f"[{coin.upper()}] Click order: {click_order}")

                # ── Step 8: Click anti-bot links in order ──
                for idx in click_order:
                    r = daemon.send("cc_click_antibot_by_index", {"index": idx})
                    if r.get("ok") and r["data"].get("clicked"):
                        log.info(f"[{coin.upper()}] Clicked anti-bot link {idx}")
                    else:
                        log.warning(f"[{coin.upper()}] Failed to click anti-bot link {idx}")
                    time.sleep(0.5)
            else:
                result["status"] = "antibot_unresolved"
                result["message"] = "Could not determine verified anti-bot click order"
                log.warning(f"[{coin.upper()}] Anti-bot order unresolved; aborting before IconCaptcha")
                return result

        # ── Step 9: Activate and wait for IconCaptcha ──
        log.info(f"[{coin.upper()}] Activating IconCaptcha...")
        daemon.send("evaluate", {"js": """
            (function() {
                const widget = document.querySelector('.iconcaptcha-widget');
                if (!widget) return {clicked:false, error:'widget not found'};
                const target = widget.querySelector('.iconcaptcha-holder, .iconcaptcha-modal, [role="button"]') || widget;
                target.scrollIntoView({block:'center'});
                target.dispatchEvent(new MouseEvent('mousedown', {bubbles:true, clientX:1, clientY:1}));
                target.dispatchEvent(new MouseEvent('mouseup', {bubbles:true, clientX:1, clientY:1}));
                target.click();
                return {clicked:true};
            })()
        """})
        log.info(f"[{coin.upper()}] Waiting for IconCaptcha to initialize...")
        time.sleep(3)

        # Check if IconCaptcha is active/challenging
        for attempt in range(10):
            r = daemon.send("evaluate", {"js": """
                (function() {
                    const w = document.querySelector('.iconcaptcha-widget');
                    if (!w) return {state: 'not_found'};
                    return {
                        state: 'found',
                        init: w.classList.contains('iconcaptcha-init'),
                        active: w.classList.contains('iconcaptcha-active'),
                        success: w.classList.contains('iconcaptcha-success'),
                        error: w.classList.contains('iconcaptcha-error'),
                        challenge: (w.querySelector('.iconcaptcha-modal__header span') || {}).textContent || '',
                    };
                })()
            """})
            if r.get("ok"):
                cap = r["data"]["result"]
                log.info(f"[{coin.upper()}] IconCaptcha state: {cap}")

                if cap.get("success"):
                    log.info(f"[{coin.upper()}] IconCaptcha already solved!")
                    break

                if cap.get("challenge") and cap.get("active"):
                    log.info(f"[{coin.upper()}] IconCaptcha challenge: '{cap['challenge']}'")
                    break

            time.sleep(2)

        # ── Step 10: Solve IconCaptcha ──
        log.info(f"[{coin.upper()}] Solving IconCaptcha...")
        r = daemon.send("cc_solve_iconcaptcha_pixel")
        if r.get("ok") and r["data"].get("clicked"):
            log.info(f"[{coin.upper()}] IconCaptcha solved! Groups: {r['data'].get('groups', '?')}")
            time.sleep(2)
        elif r.get("ok") and r["data"].get("error"):
            log.warning(f"[{coin.upper()}] IconCaptcha pixel solver error: {r['data']['error']}")
            # Try again after a moment
            time.sleep(2)
            r = daemon.send("cc_solve_iconcaptcha_pixel")
            if r.get("ok") and r["data"].get("clicked"):
                log.info(f"[{coin.upper()}] IconCaptcha solved on retry!")
                time.sleep(2)
        else:
            log.warning(f"[{coin.upper()}] IconCaptcha solve failed: {r.get('error', 'unknown')}")

        # Require confirmed IconCaptcha success before submitting.
        cap_check = daemon.send("evaluate", {"js": """
            (function() {
                const w = document.querySelector('.iconcaptcha-widget');
                return {success: !!w && w.classList.contains('iconcaptcha-success')};
            })()
        """})
        if not cap_check.get("data", {}).get("result", {}).get("success"):
            result["status"] = "captcha_unsolved"
            result["message"] = "IconCaptcha was not solved"
            log.warning(f"[{coin.upper()}] IconCaptcha unsolved; claim submit blocked")
            return result

        # ── Step 11: Click Claim button ──
        log.info(f"[{coin.upper()}] Looking for Claim button in modal...")
        r = daemon.send("evaluate", {"js": """
            (function() {
                const btns = document.querySelectorAll('button');
                for (const btn of btns) {
                    const t = btn.textContent.trim();
                    if ((t === 'Claim' || t === 'Claim!') && btn.offsetParent !== null) {
                        btn.click();
                        return {clicked: true, text: t};
                    }
                }
                // Also try submit
                const submit = document.querySelector('input[type="submit"], button[type="submit"]');
                if (submit && submit.offsetParent !== null) {
                    submit.click();
                    return {clicked: true, text: 'submit'};
                }
                return {clicked: false};
            })()
        """})

        if r.get("ok") and r["data"]["result"].get("clicked"):
            log.info(f"[{coin.upper()}] Claim button clicked!")
        else:
            log.warning(f"[{coin.upper()}] Claim button not found or not visible")

        # ── Step 12: Wait and check result ──
        time.sleep(5)
        try:
            daemon.send("wait_for_load", {"state": "networkidle", "timeout": 10000})
        except Exception:
            pass

        r = daemon.send("evaluate", {"js": """
            (function() {
                const text = document.body.innerText;
                const successKw = ['claimed successfully', 'sent to your', 'reward claimed',
                                   'you received', 'congratulations', 'successfully claimed',
                                   'claim successful', 'has been sent'];
                const errorKw = ['already claimed', 'wait', 'cooldown', 'rate limit',
                                 'invalid', 'wrong', 'captcha failed', 'incorrect captcha',
                                 'try again', 'error occurred', 'failed', 'incorrect'];

                let status = 'unknown';
                let message = '';

                const lower = text.toLowerCase();
                for (const kw of successKw) {
                    if (lower.includes(kw)) { status = 'claimed'; message = kw; break; }
                }
                if (status === 'unknown') {
                    for (const kw of errorKw) {
                        if (lower.includes(kw)) { status = 'error'; message = kw; break; }
                    }
                }

                // Check for modal with result message
                const modal = document.querySelector('.modal-body');
                const modalText = modal ? modal.innerText : '';

                // Extract amount if possible
                const amtMatch = text.match(/(\d+\.?\d*)\s*(satoshi|sat|BTC|DOGE|LTC|BCH|DASH|TRX)/i);

                return {
                    status: status,
                    message: message,
                    modalText: modalText.substring(0, 1000),
                    pageText: text.substring(0, 2000),
                    amount: amtMatch ? amtMatch[1] : '',
                };
            })()
        """})

        if r.get("ok"):
            page_result = r["data"]["result"]
            result["status"] = page_result.get("status", "unknown")
            result["message"] = page_result.get("message", "")
            result["amount"] = page_result.get("amount", "")

            if result["status"] == "claimed":
                result["amount"] = result["amount"] or REWARD_ESTIMATES.get(coin, "unknown")
                log.info(f"[{coin.upper()}] CLAIMED! Amount: {result['amount']}")
            elif result["status"] == "error":
                log.warning(f"[{coin.upper()}] Error: {result['message']}")
                # Get more details from modal text
                if page_result.get("modalText"):
                    log.info(f"[{coin.upper()}] Modal: {page_result['modalText'][:300]}")
            else:
                log.info(f"[{coin.upper()}] Result unclear. Modal: {page_result.get('modalText', '')[:300]}")
        else:
            result["status"] = "result_check_error"
            result["message"] = r.get("error", "unknown")[:200]

    except Exception as e:
        result["status"] = "exception"
        result["message"] = str(e)[:300]
        log.error(f"[{coin.upper()}] Exception: {e}")

    elapsed = time.time() - t0
    log.info(f"[{coin.upper()}] Completed in {elapsed:.1f}s — {result['status']}")

    set_cooldown(fid)
    append_ledger(
        coin=coin, faucet_id=fid,
        amount=result.get("amount", "0"),
        status=result["status"],
        details=result.get("message", ""),
    )

    return result


def print_results(results: List[Dict[str, Any]]) -> None:
    print("\n" + "=" * 70)
    print("CLAIMCLICKS RESULTS")
    print("=" * 70)
    print(f"{'COIN':<6} {'STATUS':<22} {'AMOUNT':<16} {'MESSAGE'}")
    print("-" * 70)
    claimed = 0
    for r in results:
        print(f"{r['coin'].upper():<6} {r['status']:<22} {r.get('amount', '0'):<16} {r.get('message', '')[:30]}")
        if r["status"] == "claimed":
            claimed += 1
    print("-" * 70)
    print(f"Total: {len(results)} | Claimed: {claimed} | Failed: {len(results) - claimed}")
    print("=" * 70)


def main():
    parser = argparse.ArgumentParser(description="ClaimClicks Orchestrator v1")
    parser.add_argument("coins", nargs="*", help="Coins to claim (e.g., btc doge ltc)")
    parser.add_argument("--all", action="store_true", help="Claim all 6 coins")
    parser.add_argument("--loop", action="store_true", help="Run in loop")
    parser.add_argument("--interval", type=int, default=180, help="Loop interval (s)")
    parser.add_argument("--one-shot", action="store_true", help="Single coin and exit")
    args = parser.parse_args()

    # Load config
    config = load_json(FAUCET_CFG, {})
    username = config.get("faucetpay_username", "")
    api_key = config.get("captcha", {}).get("2captcha", {}).get("api_key", "")

    if not username:
        log.error("faucetpay_username not configured in config")
        sys.exit(1)
    if not re.fullmatch(r"[A-Za-z0-9._-]{1,25}", username):
        log.error("Invalid FaucetPay username: expected 1-25 characters [A-Za-z0-9._-], not an email address")
        sys.exit(2)
    if not api_key:
        log.error("2Captcha API key not configured")
        sys.exit(1)

    log.info(f"Username: {username}")
    log.info(f"Coins: {args.coins or 'all' if args.all else 'none'}")

    # Determine target coins
    if args.all:
        target_coins = list(CLAIMCLICKS_FAUCETS.keys())
    elif args.coins:
        target_coins = [c.lower() for c in args.coins]
    else:
        log.error("Specify coins or use --all")
        sys.exit(1)

    # Launch daemon
    daemon = DaemonClient(str(SKILL_DIR / "code" / "claimclicks_daemon.py"))
    if not daemon.start():
        log.error("Failed to start daemon")
        sys.exit(1)

    try:
        iteration = 0
        while True:
            iteration += 1
            log.info(f"{'='*50} ITERATION #{iteration} {'='*50}")
            results = []

            for coin in target_coins:
                if coin not in CLAIMCLICKS_FAUCETS:
                    log.warning(f"Unknown coin: {coin}, skipping")
                    continue
                r = claim_one_coin(
                    daemon=daemon,
                    coin=coin,
                    url=CLAIMCLICKS_FAUCETS[coin],
                    username=username,
                    captcha_api_key=api_key,
                )
                results.append(r)
                if coin != target_coins[-1]:
                    time.sleep(5)

            print_results(results)

            if args.one_shot or not args.loop:
                break

            log.info(f"Sleeping {args.interval}s...")
            time.sleep(args.interval)

    finally:
        daemon.stop()
        log.info("Daemon stopped")


if __name__ == "__main__":
    main()
