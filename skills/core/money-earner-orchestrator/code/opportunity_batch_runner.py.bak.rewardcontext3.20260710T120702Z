#!/usr/bin/env python3
from __future__ import annotations
import argparse, concurrent.futures, json, re, urllib.parse, urllib.request
from datetime import datetime, timezone
from pathlib import Path
from typing import Any
B=Path(__file__).resolve().parents[1]; DATA=B/"data"; OUT=DATA/"opportunity_batch_latest.json"; TOKEN=Path("/root/.gh_token")
QUERIES=[
 "is:issue is:open (bounty OR paid OR reward) in:title,body",
 "is:issue is:open label:bounty",
 "is:issue is:open label:\"💰 bounty\"",
 "is:issue is:open (automation OR monitoring OR systemd OR docker) ($ OR USD) in:title,body",
]
DENY=("container escape","command injection","credential theft","cloud takeover","sandbox escape","hardcoded aws keys","malware","rce","remote code execution","exploit chain","request smuggling","token leak","path traversal","idor","sql injection","stored xss","csrf","web cache poisoning","session token leak","zip slip","arbitrary file write","pairing bypass","websocket hijacking","totp secret","dns zone transfer","service enumeration","crlf injection","timing attack","user enumeration","mass assignment","privilege escalation","host header injection","session fixation","ldap injection","data leak","redos","clickjacking","x-frame-options","crypto withdraw","ecb mode","s3 bucket misconfiguration")
BLOCKED_REPOS={"claude-builders-bounty/claude-builders-bounty","xevrion-v2/agent-playground","zhangjiayang6835-cyber/ai-research"}
SKILLS={"python":3,"linux":3,"systemd":4,"docker":3,"api":2,"github actions":3,"monitoring":4,"sre":5,"automation":4,"playwright":2,"bash":3,"kubernetes":3,"terraform":3,"documentation":2,"changelog":2}
def fetch(url:str, token:str="")->Any:
 h={"Accept":"application/vnd.github+json","User-Agent":"octopus-opportunity-batch"}
 if token:h["Authorization"]="Bearer "+token
 with urllib.request.urlopen(urllib.request.Request(url,headers=h),timeout=25) as r:return json.loads(r.read().decode())
def reward(text:str):
 # A dollar amount alone is not a bounty: it may be a cost, budget, price, or example.
 # Require explicit compensation language and reject local cost/expense context.
 positive=("bounty","reward","payout","paid","payment","compensation","prize","funded")
 negative=("cost","costs","expense","expenses","budget","price","pricing","upkeep","fee","fees")
 vals=[]
 for m in re.finditer(r"(?:\$|USD\s*|USDC\s*)(\d{1,6}(?:[.,]\d{1,2})?)",text,re.I):
  lo=max(0,m.start()-90); hi=min(len(text),m.end()+90); window=text[lo:hi].lower()
  if not any(k in window for k in positive): continue
  if any(k in window for k in negative): continue
  try: vals.append(float(m.group(1).replace(",",".")))
  except ValueError: pass
 return max(vals) if vals else None

def search_one(q:str,token:str):
 u="https://api.github.com/search/issues?"+urllib.parse.urlencode({"q":q,"sort":"updated","order":"desc","per_page":100})
 return fetch(u,token).get("items",[])
def repo_name(item):
 u=item.get("repository_url",""); return "/".join(u.rstrip("/").split("/")[-2:])
def inspect_repo(repo:str,token:str):
 d=fetch("https://api.github.com/repos/"+repo,token)
 return {"repo":repo,"stars":d.get("stargazers_count",0),"forks":d.get("forks_count",0),"open_issues":d.get("open_issues_count",0),"archived":d.get("archived",False),"pushed_at":d.get("pushed_at"),"created_at":d.get("created_at")}
def main():
 ap=argparse.ArgumentParser();ap.add_argument("--workers",type=int,default=8);ap.add_argument("--limit",type=int,default=50);a=ap.parse_args();token=TOKEN.read_text().strip() if TOKEN.exists() else ""
 seen={};errors=[]
 with concurrent.futures.ThreadPoolExecutor(max_workers=min(a.workers,len(QUERIES))) as ex:
  fs={ex.submit(search_one,q,token):q for q in QUERIES}
  for f,q in fs.items():
   try:
    for x in f.result():seen[x["html_url"]]=x
   except Exception as e:errors.append({"phase":"search","query":q,"error":str(e)[:180]})
 candidates=[]
 for item in seen.values():
  text=((item.get("title") or "")+" "+(item.get("body") or "")+" "+" ".join(x.get("name","") for x in item.get("labels",[]))).lower()
  amt=reward(text); repo=repo_name(item)
  if amt is None or amt<10 or any(x in text for x in DENY) or repo in BLOCKED_REPOS or item.get("comments",0)>25:continue
  candidates.append((item,text,amt,repo))
 repos=sorted({x[3] for x in candidates});meta={}
 with concurrent.futures.ThreadPoolExecutor(max_workers=a.workers) as ex:
  fs={ex.submit(inspect_repo,r,token):r for r in repos}
  for f,r in fs.items():
   try:meta[r]=f.result()
   except Exception as e:errors.append({"phase":"repo","repo":r,"error":str(e)[:180]})
 rows=[]
 for item,text,amt,repo in candidates:
  m=meta.get(repo)
  if not m or m["archived"] or m["stars"]<10 or m["open_issues"]>1000:continue
  sc=10+min(30,int(amt/25))
  why=[f"reward={amt:g}", f"stars={m.get('stars',0)}", f"open_issues={m.get('open_issues',0)}"]
  for k,w in SKILLS.items():
   if k in text:sc+=w;why.append("skill:"+k)
  sc-=min(8,item.get("comments",0)//3)
  rows.append({"score":sc,"reward_usd":amt,"title":item.get("title"),"url":item.get("html_url"),"repo":repo,"comments":item.get("comments",0),"repo_meta":m,"reasons":why})
 rows.sort(key=lambda x:(x["score"],x["reward_usd"],x["repo_meta"]["stars"]),reverse=True)
 report={"generated_at":datetime.now(timezone.utc).isoformat(),"mode":"parallel_read_only","workers":a.workers,"queries":len(QUERIES),"raw":len(seen),"eligible":len(rows),"errors":errors,"opportunities":rows[:a.limit]}
 DATA.mkdir(parents=True,exist_ok=True);OUT.write_text(json.dumps(report,ensure_ascii=False,indent=2)+"\n")
 print(f"raw={len(seen)} eligible={len(rows)} errors={len(errors)} workers={a.workers}")
if __name__=="__main__":main()
