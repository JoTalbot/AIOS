#!/usr/bin/env python3
from fastapi import FastAPI, HTTPException
from pydantic import BaseModel, Field
from typing import Any
from pathlib import Path
from datetime import datetime, timezone
from urllib.parse import urlparse
import asyncio, hashlib, json, re, socket, ssl, subprocess, time
import httpx
app=FastAPI(title='Octopus Income MVP Host',version='1.0.0')
START=time.time()
class UrlReq(BaseModel): url:str; timeout_sec:int=Field(default=10,ge=1,le=30)
class DomainReq(BaseModel): domain:str; port:int=Field(default=443,ge=1,le=65535); timeout_sec:int=Field(default=10,ge=1,le=30)
class WebhookReq(BaseModel): payload:dict[str,Any]; mapping:dict[str,str]={}
class CronReq(BaseModel): last_run_iso:str; max_age_sec:int=Field(default=3600,ge=1,le=604800)
class TextReq(BaseModel): text:str=Field(min_length=1,max_length=200000)
class GithubReq(BaseModel): repository:str; limit:int=Field(default=20,ge=1,le=100)
class AlertReq(BaseModel): message:str=Field(min_length=1,max_length=4000); dry_run:bool=True
class ReportReq(BaseModel): title:str; sections:dict[str,Any]
@app.get('/health')
def health(): return {'ok':True,'uptime_sec':round(time.time()-START,2),'modules':8}
@app.post('/v1/uptime/check')
async def uptime_check(r:UrlReq):
    t=time.perf_counter()
    try:
        async with httpx.AsyncClient(follow_redirects=True,timeout=r.timeout_sec) as c: resp=await c.get(r.url)
        return {'ok':resp.status_code<500,'status_code':resp.status_code,'latency_ms':round((time.perf_counter()-t)*1000,2),'final_url':str(resp.url)}
    except Exception as e: return {'ok':False,'error':type(e).__name__,'latency_ms':round((time.perf_counter()-t)*1000,2)}
@app.post('/v1/domain/ssl')
async def domain_ssl(r:DomainReq):
    d=r.domain.strip().lower()
    if not re.fullmatch(r'[a-z0-9.-]+',d): raise HTTPException(400,'invalid domain')
    def work():
        ctx=ssl.create_default_context()
        with socket.create_connection((d,r.port),timeout=r.timeout_sec) as s:
            with ctx.wrap_socket(s,server_hostname=d) as ss: return ss.getpeercert()
    try:
        cert=await asyncio.to_thread(work); exp=datetime.strptime(cert['notAfter'],'%b %d %H:%M:%S %Y %Z').replace(tzinfo=timezone.utc)
        return {'ok':True,'domain':d,'expires_at':exp.isoformat(),'days_remaining':(exp-datetime.now(timezone.utc)).days,'issuer':cert.get('issuer')}
    except Exception as e:return {'ok':False,'domain':d,'error':type(e).__name__}
@app.post('/v1/cron/health')
def cron_health(r:CronReq):
    try:last=datetime.fromisoformat(r.last_run_iso.replace('Z','+00:00')); age=(datetime.now(timezone.utc)-last.astimezone(timezone.utc)).total_seconds()
    except Exception: raise HTTPException(400,'invalid timestamp')
    return {'ok':age<=r.max_age_sec,'age_sec':round(age,2),'max_age_sec':r.max_age_sec}
@app.post('/v1/webhook/transform')
def webhook_transform(r:WebhookReq):
    out={}
    for dst,src in r.mapping.items():
        cur:Any=r.payload
        for part in src.split('.'):
            if not isinstance(cur,dict) or part not in cur: cur=None; break
            cur=cur[part]
        out[dst]=cur
    return {'ok':True,'output':out or r.payload}
@app.post('/v1/log/analyze')
def log_analyze(r:TextReq):
    lines=r.text.splitlines(); pats={'error':r'\berror\b|exception|traceback','warning':r'\bwarn(?:ing)?\b','timeout':r'timeout|timed out','http_5xx':r'\b5\d\d\b'}
    counts={k:sum(bool(re.search(p,l,re.I)) for l in lines) for k,p in pats.items()}
    return {'ok':True,'lines':len(lines),'counts':counts,'risk':'high' if counts['error']+counts['http_5xx']>5 else 'medium' if any(counts.values()) else 'low'}
@app.post('/v1/github/triage')
def github_triage(r:GithubReq):
    if not re.fullmatch(r'[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+',r.repository): raise HTTPException(400,'invalid repository')
    env={'GH_TOKEN':Path('/root/.gh_token').read_text().strip()} if Path('/root/.gh_token').exists() else None
    p=subprocess.run(['gh','issue','list','--repo',r.repository,'--state','open','--limit',str(r.limit),'--json','number,title,labels,updatedAt'],capture_output=True,text=True,timeout=30,env=env)
    if p.returncode: raise HTTPException(502,'github query failed')
    issues=json.loads(p.stdout or '[]')
    for x in issues:
        title=x.get('title','').lower(); labels=[z.get('name','').lower() for z in x.get('labels',[])]
        score=(3 if any(k in title for k in ['bug','error','crash','security']) else 0)+(2 if 'good first issue' in labels else 0)+(1 if 'help wanted' in labels else 0)
        x['priority_score']=score
    issues.sort(key=lambda x:x['priority_score'],reverse=True)
    return {'ok':True,'repository':r.repository,'issues':issues}
@app.post('/v1/telegram/alert')
def telegram_alert(r:AlertReq):
    digest=hashlib.sha256(r.message.encode()).hexdigest()[:16]
    if r.dry_run:return {'ok':True,'dry_run':True,'message_idempotency_key':digest}
    raise HTTPException(403,'live send requires dedicated allowlisted connector')
@app.post('/v1/report/render')
def report_render(r:ReportReq):
    body=['# '+r.title,'','Generated: '+datetime.now(timezone.utc).isoformat(),'']
    for k,v in r.sections.items(): body += ['## '+str(k),'',json.dumps(v,ensure_ascii=False,indent=2) if not isinstance(v,str) else v,'']
    md='\n'.join(body); return {'ok':True,'format':'markdown','content':md,'sha256':hashlib.sha256(md.encode()).hexdigest()}
