[Unit]
Description=AIOS waiting clients reminder
After=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python /root/AIOS/run_waiting_clients.py
StandardOutput=append:/root/AIOS/logs/waiting_clients.log
StandardError=append:/root/AIOS/logs/waiting_clients.log
