[Unit]
Description=AIOS Background Calls Transcriber Daemon
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/AIOS
Environment=PYTHONPATH=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python -u /root/AIOS/aios_core/whisper_colab_transcriber.py
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
