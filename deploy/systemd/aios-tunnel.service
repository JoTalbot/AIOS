# Install on the FRONTEND server (autosklo).
# Forwards local 18500/8571/8580 to UBU's 8500/8571/8580 via SSH.
[Unit]
Description=AIOS SSH Tunnel (frontend -> AIOS host 8500/8571/8580)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
ExecStart=/usr/bin/ssh -NT \
    -i /root/.ssh/id_ed25519 \
    -p 2222 \
    -o BatchMode=yes \
    -o StrictHostKeyChecking=accept-new \
    -o UserKnownHostsFile=/root/.ssh/known_hosts \
    -o ServerAliveInterval=30 \
    -o ServerAliveCountMax=3 \
    -o ExitOnForwardFailure=yes \
    -o ConnectTimeout=15 \
    -L 127.0.0.1:18580:127.0.0.1:8580 \
    -L 127.0.0.1:18500:127.0.0.1:8500 \
    -L 127.0.0.1:18571:127.0.0.1:8571 \
    root@37.52.63.245
Restart=always
RestartSec=10
StandardOutput=append:/var/log/aios-tunnel.log
StandardError=append:/var/log/aios-tunnel.log

[Install]
WantedBy=multi-user.target
