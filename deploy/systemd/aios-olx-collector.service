[Unit]
Description=AIOS OLX HTTP Collector Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/AIOS
EnvironmentFile=-/root/AIOS/.env
ExecStart=/usr/bin/python3 /root/AIOS/run_olx_http_collector.py --daemon --interval 1800 --max-cards 300
Restart=always
RestartSec=20
StandardOutput=append:/root/AIOS/logs/olx_collector.log
StandardError=append:/root/AIOS/logs/olx_collector.log

[Install]
WantedBy=multi-user.target
