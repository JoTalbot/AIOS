[Unit]
Description=AIOS weekly market digest (Sun 19:00 Kyiv)
After=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python /root/AIOS/run_weekly_digest.py
StandardOutput=append:/root/AIOS/logs/weekly_digest.log
StandardError=append:/root/AIOS/logs/weekly_digest.log
