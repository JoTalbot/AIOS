#!/usr/bin/env python3
import json, subprocess
from datetime import datetime, timezone
from pathlib import Path
R=Path('/root/agents/-Octopus'); B=R/'skills/core/money-earner-orchestrator'; D=B/'data'
TARGET='JoTalbot/octopus'; MARK='<!-- octopus-service-catalog-v1 -->'
env={'GH_TOKEN':Path('/root/.gh_token').read_text().strip()}
p=subprocess.run(['gh','issue','list','--repo',TARGET,'--state','all','--limit','100','--json','number,title,body,state,updatedAt'],capture_output=True,text=True,env={**env},timeout=60)
errors=[]
try: issues=json.loads(p.stdout or '[]')
except Exception as e: issues=[]; errors.append('invalid_github_json:'+type(e).__name__)
if p.returncode!=0: errors.append('github_query_failed')
marked=[x for x in issues if MARK in (x.get('body') or '')]
open_marked=sorted((x for x in marked if x.get('state')=='OPEN'),key=lambda x:int(x.get('number',0)))
closed_marked=sorted((x for x in marked if x.get('state')=='CLOSED'),key=lambda x:int(x.get('number',0)))
canonical=open_marked[0] if open_marked else (marked[0] if marked else None)
duplicates=[x for x in marked if not canonical or x.get('number')!=canonical.get('number')]
out={'generated_at':datetime.now(timezone.utc).isoformat(),'mode':'read_only_external_publication_reconcile','repository':TARGET,'marker':MARK,'healthy':len(open_marked)<=1 and not errors,'canonical_issue':canonical.get('number') if canonical else None,'open_marked_count':len(open_marked),'closed_marked_count':len(closed_marked),'duplicate_count':len(duplicates),'duplicates':[{'number':x.get('number'),'state':x.get('state'),'title':x.get('title')} for x in duplicates],'errors':errors,'external_actions_performed':False}
D.mkdir(parents=True,exist_ok=True); (D/'external_publication_reconcile_latest.json').write_text(json.dumps(out,ensure_ascii=False,indent=2)+'\n')
print(json.dumps(out,ensure_ascii=False))
raise SystemExit(0 if not errors else 1)
