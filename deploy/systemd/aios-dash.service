[Unit]
Description=AIOS Web Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/AIOS
EnvironmentFile=-/root/AIOS/.env
ExecStart=/usr/bin/python3 -u /root/AIOS/run_dashboard.py --host 0.0.0.0 --port 8580
Restart=always
RestartSec=5
StandardOutput=append:/root/AIOS/logs/dash.log
StandardError=append:/root/AIOS/logs/dash.log

[Install]
WantedBy=multi-user.target
