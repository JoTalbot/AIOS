[Unit]
Description=AIOS Autonomy Security Report
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python /root/AIOS/run_autonomy_security.py --send
StandardOutput=append:/root/AIOS/logs/autonomy_sec.log
StandardError=append:/root/AIOS/logs/autonomy_sec.log
