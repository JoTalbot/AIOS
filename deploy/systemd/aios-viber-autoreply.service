[Unit]
Description=AIOS Viber draft/autoreply loop
After=network-online.target aios-viber-desktop.service
Wants=network-online.target
Requires=aios-viber-desktop.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/AIOS
Environment=VIBER_DISPLAY=:1
Environment=XAUTHORITY=/root/.Xauthority
ExecStart=/opt/aios/.venv/bin/python -u /root/AIOS/run_platform_autoreply.py viber --loop --interval 300
Restart=always
RestartSec=20
StandardOutput=append:/root/AIOS/logs/viber_autoreply.log
StandardError=append:/root/AIOS/logs/viber_autoreply.log

[Install]
WantedBy=multi-user.target
