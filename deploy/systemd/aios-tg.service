[Unit]
Description=AIOS Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/AIOS
EnvironmentFile=-/root/AIOS/.env
LoadCredential=telegram_token:/etc/aios/credentials/telegram_token
LoadCredential=telegram_queue_key:/etc/aios/credentials/telegram_queue_key
Environment=TELEGRAM_QUEUE_KEY_FILE=%d/telegram_queue_key
ExecStart=/usr/bin/python3 -u /root/AIOS/run_telegram_bot.py
Restart=always
RestartSec=5
UMask=0077
StandardOutput=append:/root/AIOS/logs/tg.log
StandardError=append:/root/AIOS/logs/tg.log

[Install]
WantedBy=multi-user.target
