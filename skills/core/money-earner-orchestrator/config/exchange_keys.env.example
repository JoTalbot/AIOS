# exchange.env — ШАБЛОН. Этот файл содержит ПРИМЕР, не реальные ключи.
# Реальные ключи кладутся ВНЕ репозитория/скилла по пути:
#   ~/agents/-Octopus/secrets/exchange.env   (chmod 600, владелец root)
# Формат: KEY=value. Строки с # — комментарии.
#
# ТРЕБОВАНИЯ К КЛЮЧУ (обязательно):
#   - права ТОЛЬКО read + trade (чтение баланса и выставление ордеров);
#   - БЕЗ права withdrawal/вывода средств (withdraw enable = OFF);
#   - по возможности ограничить по IP сервера.
#
# После создания файла с реальными ключами агент установит в consent.json:
#   approved_exchanges=["<exchange>"], api_keys_present=true
# и (после отдельного подтверждения) execution_armed=true.
#
exchange=binance
api_key=PUT_READ_TRADE_API_KEY_HERE
api_secret=PUT_API_SECRET_HERE
# passphrase=NEEDED_ONLY_FOR_OKX
