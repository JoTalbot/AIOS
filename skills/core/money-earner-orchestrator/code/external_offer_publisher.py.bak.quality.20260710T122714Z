#!/usr/bin/env python3
import json, os, subprocess, sys
from datetime import datetime, timezone
from pathlib import Path
R=Path('/root/agents/-Octopus'); B=R/'skills/core/money-earner-orchestrator'; D=B/'data'; CFG=R/'config'
POL=json.loads((CFG/'execution_policy.json').read_text()); CAT=json.loads((CFG/'service_catalog.json').read_text())
TARGET='JoTalbot/octopus'; MARK='<!-- octopus-service-catalog-v1 -->'
if os.environ.get('OCTOPUS_EXTERNAL_EFFECT_LOCKED')!='1': raise SystemExit('external publication requires global lock')
gh=POL.get('github_write_actions',{})
if not gh.get('enabled') or TARGET not in gh.get('allowlist_repositories',[]): raise SystemExit('publication target not allowed')
state_path=D/'external_publication_state.json'
try: state=json.loads(state_path.read_text())
except Exception: state={'publications':[]}
today=datetime.now(timezone.utc).date().isoformat()
today_count=sum(1 for x in state.get('publications',[]) if str(x.get('ts','')).startswith(today))
if today_count>=int(gh.get('max_publications_per_day',1)): print(json.dumps({'ok':True,'skipped':'daily_limit'})); raise SystemExit(0)
rows=['| Услуга | Цена, USD | Результат |','|---|---:|---|']
for s in CAT.get('services',[]): rows.append(f"| `{s['id']}` | {s['price_usd']} | {s['deliverable']} |")
body=MARK+'\n# Octopus: каталог SRE и automation-услуг\n\n'+"\n".join(rows)+'\n\nЗаказы проходят валидацию, idempotency-проверку и исполняются с ограничениями CPU/RAM/времени. Внешние изменения сериализуются глобальным lock.\n'
env={**os.environ,'GH_TOKEN':Path('/root/.gh_token').read_text().strip()}
q=subprocess.run(['gh','issue','list','--repo',TARGET,'--state','open','--search','Octopus каталог SRE in:title','--json','number,title,body'],capture_output=True,text=True,env=env,check=True)
issues=json.loads(q.stdout or '[]'); existing=next((x for x in issues if MARK in (x.get('body') or '')),None)
if existing:
 subprocess.run(['gh','issue','edit',str(existing['number']),'--repo',TARGET,'--title','Octopus: каталог SRE и automation-услуг','--body',body],check=True,env=env,capture_output=True,text=True)
 action='updated'; number=existing['number']
else:
 r=subprocess.run(['gh','issue','create','--repo',TARGET,'--title','Octopus: каталог SRE и automation-услуг','--body',body],check=True,env=env,capture_output=True,text=True)
 action='created'; number=r.stdout.strip().rstrip('/').split('/')[-1]
rec={'ts':datetime.now(timezone.utc).isoformat(),'channel':'github','repository':TARGET,'action':action,'issue_number':number,'idempotency_marker':MARK}
state.setdefault('publications',[]).append(rec); state['publications']=state['publications'][-100:]; state_path.write_text(json.dumps(state,ensure_ascii=False,indent=2)+'\n')
(D/'external_offer_publication_latest.json').write_text(json.dumps(rec,ensure_ascii=False,indent=2)+'\n')
print(json.dumps({'ok':True,**rec},ensure_ascii=False))
