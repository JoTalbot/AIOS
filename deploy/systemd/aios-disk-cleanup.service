[Unit]
Description=AIOS Disk Cleanup
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python /root/AIOS/run_disk_cleanup.py
Environment=PYTHONUNBUFFERED=1
StandardOutput=append:/root/AIOS/logs/disk_cleanup.log
StandardError=append:/root/AIOS/logs/disk_cleanup.log
