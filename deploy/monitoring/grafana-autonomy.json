{
  "title": "AIOS Autonomy",
  "uid": "aios-autonomy",
  "tags": ["aios", "autonomy"],
  "schemaVersion": 39,
  "version": 1,
  "time": {"from": "now-24h", "to": "now"},
  "refresh": "5m",
  "templating": {"list": []},
  "annotations": {"list": []},
  "panels": [
    {
      "id": 1,
      "title": "Решений всего",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 4, "w": 3, "x": 0, "y": 0},
      "targets": [{"expr": "sum(aios_autonomy_decisions_total)", "refId": "A"}],
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "center"}
    },
    {
      "id": 2,
      "title": "Продажи (шт)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 4, "w": 3, "x": 3, "y": 0},
      "targets": [{"expr": "aios_autonomy_sales_total", "refId": "A"}],
      "options": {"colorMode": "value", "graphMode": "area"}
    },
    {
      "id": 3,
      "title": "Сумма продаж (грн)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 4, "w": 3, "x": 6, "y": 0},
      "targets": [{"expr": "aios_autonomy_sales_amount_total", "refId": "A"}],
      "options": {"colorMode": "value", "graphMode": "area"}
    },
    {
      "id": 4,
      "title": "Ожидают решения владельца",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 4, "w": 3, "x": 9, "y": 0},
      "targets": [{"expr": "aios_autonomy_approvals_pending", "refId": "A"}],
      "options": {"colorMode": "value", "graphMode": "area"}
    },
    {
      "id": 5,
      "title": "Решения по типам",
      "type": "bargauge",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [{"expr": "sum by (decision) (aios_autonomy_decisions_total)", "refId": "A"}],
      "options": {"orientation": "horizontal", "displayMode": "basic"}
    },
    {
      "id": 6,
      "title": "Действия по типам",
      "type": "bargauge",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [{"expr": "sum by (action) (aios_autonomy_actions_total)", "refId": "A"}],
      "options": {"orientation": "horizontal", "displayMode": "basic"}
    },
    {
      "id": 7,
      "title": "Тренд решений",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 12},
      "targets": [
        {"expr": "sum by (decision) (rate(aios_autonomy_decisions_total[1h]))", "refId": "A", "legendFormat": "{{decision}}"}
      ]
    }
  ]
}
