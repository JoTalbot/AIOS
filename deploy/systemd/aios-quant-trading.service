[Unit]
Description=AIOS Quant Trading & Signal Radar - количественный анализ криптовалют и Paper Trading
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/AIOS
Environment=PYTHONPATH=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python -u /root/AIOS/run_quant_trading.py --daemon --interval 900
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
