[Unit]
Description=AIOS MCP Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/AIOS
EnvironmentFile=-/root/AIOS/.env
ExecStart=/usr/bin/python3 -u /root/AIOS/run_mcp_server.py --host 0.0.0.0 --port 8571 --db /root/AIOS/aios.sqlite
Restart=always
RestartSec=5
StandardOutput=append:/root/AIOS/logs/mcp.log
StandardError=append:/root/AIOS/logs/mcp.log

[Install]
WantedBy=multi-user.target
