[Unit]
Description=Verify latest encrypted Telegram queue backup and key escrow
After=local-fs.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/AIOS
Environment=AIOS_TELEGRAM_BACKUP_DIR=/var/backups/aios/telegram-queues
Environment=AIOS_TELEGRAM_KEY_BACKUP_DIR=/var/backups/aios/telegram-queue-keys
ExecStart=/opt/aios/.venv/bin/python /root/AIOS/scripts/telegram_queue_backup.py --verify-latest
UMask=0077
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/var/backups/aios/telegram-queues /var/backups/aios/telegram-queue-keys
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
