[Unit]
Description=AIOS T2 momentum paper loop (BTC close vs SMA50, daily signal + TG)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/AIOS
Environment=PYTHONPATH=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python -u /root/AIOS/scripts/run_t2_momentum.py --notify

[Install]
WantedBy=multi-user.target
