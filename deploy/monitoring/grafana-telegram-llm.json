{
  "title": "AIOS Telegram & Colab LLM",
  "uid": "aios-telegram-llm",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {"from": "now-24h", "to": "now"},
  "refresh": "30s",
  "tags": ["aios", "telegram", "colab", "llm"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Full canary",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{"expr": "aios_telegram_canary_ok", "refId": "A"}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "FAILED", "color": "red"}, "1": {"text": "OK", "color": "green"}}}], "thresholds": {"steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Canary age",
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{"expr": "aios_telegram_canary_age_seconds", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "orange", "value": 720}, {"color": "red", "value": 900}]}}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Delivery success",
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{"expr": "aios_telegram_delivery_success_ratio", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"steps": [{"color": "red", "value": null}, {"color": "orange", "value": 0.95}, {"color": "green", "value": 0.99}]}}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Ambiguous sends",
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{"expr": "aios_telegram_queue_jobs{queue=\"outbox\",status=\"failed_unknown\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Generation / send / total latency",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 6},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{"expr": "aios_telegram_latency_seconds", "legendFormat": "{{phase}} p{{quantile}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Durable queue states",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 6},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{"expr": "aios_telegram_queue_jobs", "legendFormat": "{{queue}} / {{status}}", "refId": "A"}]
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "LLM provider routing (24h)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{"expr": "aios_telegram_provider_events", "legendFormat": "{{provider}}", "refId": "A"}]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Sent vs failed (24h rolling)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{"expr": "aios_telegram_delivery_events", "legendFormat": "{{status}}", "refId": "A"}]
    }
  ]
}
