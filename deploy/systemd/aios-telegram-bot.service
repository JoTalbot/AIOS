[Unit]
Description=AIOS Telegram Bot
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python -u /root/AIOS/run_telegram_bot.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/root/AIOS
EnvironmentFile=/etc/aios/aios-telegram-bot.env
StandardOutput=append:/root/AIOS/logs/telegram_bot.log
StandardError=append:/root/AIOS/logs/telegram_bot.log

[Install]
WantedBy=multi-user.target
