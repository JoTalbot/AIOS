[Unit]
Description=AIOS OLX HTTP Collector
After=network.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/AIOS
ExecStart=/usr/bin/python3 /root/AIOS/run_olx_http_collector.py \
    --daemon \
    --interval 1800 \
    --queries 'авторазборка' 'разбор ваз' 'разбор газель' 'запчасти ваз б/у' 'запчасти газель б/у' 'розбор ваз' 'розбор газель' 'запчастини ваз' 'запчастини газель' 'капот шкода октавия' 'фара шкода октавия' 'фара bmw x5' {NEWQ} \
    --max-cards 100 \
    --db /root/AIOS/data/olx_http.sqlite
Restart=on-failure
RestartSec=30
EnvironmentFile=/etc/aios/aios-auto-coder.env
StandardOutput=append:/root/AIOS/logs/olx_collector.log
StandardError=append:/root/AIOS/logs/olx_collector.log

[Install]
WantedBy=multi-user.target
