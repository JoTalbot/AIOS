global:
  resolve_timeout: 5m

route:
  receiver: telegram-owner
  group_by: [alertname]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - receiver: delivery-canary
      matchers:
        - alertname="AIOSAlertmanagerDeliveryCanary"
      group_by: [alertname, canary_nonce]
      group_wait: 0s
      group_interval: 1m
      repeat_interval: 24h
      continue: false

receivers:
  - name: telegram-owner
    telegram_configs:
      - bot_token_file: /run/secrets/telegram_token
        chat_id: __TELEGRAM_OWNER_CHAT_ID__
        send_resolved: true
        parse_mode: ""
        disable_notifications: false
        message: |-
          {{ if eq .Status "firing" }}AIOS alert{{ else }}AIOS resolved{{ end }}
          {{ range .Alerts }}{{ .Labels.alertname }}: {{ .Annotations.summary }}
          {{ end }}

  - name: delivery-canary
    webhook_configs:
      - url: http://aios-alert-canary-receiver:9099/alert
        send_resolved: false
        max_alerts: 1

inhibit_rules:
  - source_matchers: [severity="critical"]
    target_matchers: [severity="warning"]
    equal: [alertname]
