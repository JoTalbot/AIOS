[Unit]
Description=AIOS Long-term DCA Portfolio paper tracker (daily mark-to-market)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/AIOS
Environment=PYTHONPATH=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python -u /root/AIOS/scripts/run_dca_paper.py

[Install]
WantedBy=multi-user.target
