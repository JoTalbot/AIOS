#!/usr/bin/env python3
from __future__ import annotations
import concurrent.futures, json, os, subprocess
from datetime import datetime, timezone
from pathlib import Path
B=Path('/root/agents/-Octopus/skills/core/money-earner-orchestrator')
DATA=B/'data'; REPORT=DATA/'autopilot_latest.json'
TASKS={
 'opportunities':['/usr/bin/python3',str(B/'code/opportunity_aggregate_runner.py')],
 'faucet_probe':['/usr/bin/python3',str(B/'code/playwright_faucet_claimer.py'),'--faucets','btcpop-faucet,dash-faucet-com,cryptofaucet-club,cryptofaucet-ltc','--probe-only'],
 'paper_trade':['/usr/bin/python3',str(B/'code/run.py'),'--json'],
 'roadmap_audit':['/usr/bin/python3',str(B/'code/roadmap_audit_batch.py')],
 'process_guard':['/usr/bin/python3',str(B/'code/bounded_process_guard.py')],
 'metrics_snapshot':['/usr/bin/python3',str(B/'code/metrics_snapshot.py')],
 'timer_health':['/usr/bin/python3',str(B/'code/timer_health.py')],
 'captcha_budget_audit':['/usr/bin/python3',str(B/'code/captcha_budget_audit.py')],
 'currency_ledger':['/usr/bin/python3',str(B/'code/currency_ledger.py')],
 'source_roi_gate':['/usr/bin/python3',str(B/'code/source_roi_gate.py')],
 'self_sufficiency_status':['/usr/bin/python3',str(B/'code/self_sufficiency_status.py')],
}
def run_task(name,cmd):
    try:
        p=subprocess.run(cmd,cwd=B,capture_output=True,text=True,timeout=170,env={**os.environ,'OCTOPUS_AUTOPILOT':'1'})
        return {'name':name,'ok':p.returncode==0,'code':p.returncode,'stdout':p.stdout[-1200:],'stderr':p.stderr[-1200:]}
    except Exception as e:
        return {'name':name,'ok':False,'error':str(e)[:300]}
def main():
    results=[]
    with concurrent.futures.ThreadPoolExecutor(max_workers=min(8,len(TASKS))) as ex:
        futs={ex.submit(run_task,n,c):n for n,c in TASKS.items()}
        for f in concurrent.futures.as_completed(futs): results.append(f.result())
    daily=run_task('daily_summary',['/usr/bin/python3',str(B/'code/daily_summary.py')])
    results.append(daily)
    report={'generated_at':datetime.now(timezone.utc).isoformat(),'mode':'automatic_parallel_safe','workers':min(8,len(TASKS)),'tasks':results,'ok':all(x.get('ok') for x in results)}
    DATA.mkdir(parents=True,exist_ok=True); REPORT.write_text(json.dumps(report,ensure_ascii=False,indent=2)+'\n')
    print(json.dumps({'ok':report['ok'],'tasks':{x['name']:x.get('ok',False) for x in results}},ensure_ascii=False))
    raise SystemExit(0 if report['ok'] else 1)
if __name__=='__main__': main()
