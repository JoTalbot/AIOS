[Unit]
Description=Prepare tmpfs credentials for non-root AIOS monitoring containers
DefaultDependencies=no
After=local-fs.target
Before=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python /root/AIOS/scripts/prepare_docker_runtime_credentials.py
RemainAfterExit=true
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/etc/aios/credentials /root/AIOS
ReadWritePaths=/run/aios-docker-credentials /etc/aios
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=CAP_CHOWN

[Install]
RequiredBy=docker.service
