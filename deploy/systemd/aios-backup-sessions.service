[Unit]
Description=AIOS Sessions Backup
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python /root/AIOS/run_backup_sessions.py
Environment=PYTHONUNBUFFERED=1
StandardOutput=append:/root/AIOS/logs/backup_sessions.log
StandardError=append:/root/AIOS/logs/backup_sessions.log
