[Unit]
Description=AIOS Converge — mobile unified messenger hub (Stitch design)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/AIOS/converge
Environment=PYTHONUNBUFFERED=1
Environment=AIOS_ROOT=/root/AIOS
Environment=CONVERGE_HOST=127.0.0.1
Environment=CONVERGE_PORT=8092
Environment=PYTHONPATH=/root/AIOS:/root/AIOS/converge
ExecStart=/opt/aios/.venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 8092 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3
StandardOutput=append:/root/AIOS/logs/converge.log
StandardError=append:/root/AIOS/logs/converge.log

[Install]
WantedBy=multi-user.target
