[Unit]
Description=AIOS Gitcoin & Algora Bounty Solver - авто-решение баунти-задач и публикация решений на GitHub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/AIOS
Environment=PYTHONPATH=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python -u /root/AIOS/run_gitcoin_algora_solver.py --daemon --interval 7200
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
