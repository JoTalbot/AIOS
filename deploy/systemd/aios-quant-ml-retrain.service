[Unit]
Description=AIOS Quant ML retrain (CatBoost v2, deploy only if better)
After=aios-market-data.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/AIOS
Environment=PYTHONPATH=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python /root/AIOS/scripts/quant_ml_eval_train.py
Nice=10

[Install]
WantedBy=multi-user.target
