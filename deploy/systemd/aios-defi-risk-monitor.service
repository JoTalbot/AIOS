[Unit]
Description=AIOS DeFi Yield Risk Gate (read-only)
After=aios-liquidity-router.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/AIOS
Environment=PYTHONPATH=/root/AIOS
ExecStart=/bin/bash -lc '/opt/aios/.venv/bin/python scripts/check_defi_yield_gate.py; rc=$?; test $rc -eq 0 -o $rc -eq 1'

[Install]
WantedBy=multi-user.target
