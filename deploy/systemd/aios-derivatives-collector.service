[Unit]
Description=AIOS hourly derivatives accumulator (LSR/OI/taker)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/AIOS
Environment=PYTHONPATH=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python -u /root/AIOS/scripts/collect_derivatives_daily.py

[Install]
WantedBy=multi-user.target
