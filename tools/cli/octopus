#!/usr/bin/env python3
import sys, json, subprocess

BASE = '/mnt/agents/-Octopus'
SHARED = '/mnt/agents/-SharedIntegrations'

def cmd_memory(args):
    action = args[0] if args else 'list'
    if action == 'add' and len(args) >= 2:
        title = args[1]
        content = ' '.join(args[2:]) if len(args) > 2 else title
        sys.path.insert(0, BASE + '/skills/memory/pwa-file-exchange')
        from memory_api import save_memory_item
        item = save_memory_item(str(__import__('uuid').uuid4()), 'note', title, content)
        print(json.dumps({'ok': True, 'action': 'add', 'item': item}, ensure_ascii=False))
    elif action == 'find' and len(args) >= 2:
        query = args[1]
        sys.path.insert(0, BASE + '/skills/memory/pwa-file-exchange')
        from memory_api import search_memory
        items = search_memory(query)
        print(json.dumps({'ok': True, 'action': 'find', 'query': query, 'items': items}, ensure_ascii=False))
    else:
        print(json.dumps({'ok': True, 'action': 'list', 'items': []}, ensure_ascii=False))

def cmd_lead(args):
    action = args[0] if args else 'list'
    if action == 'send' and len(args) >= 4:
        project, contact, intent = args[1], args[2], args[3]
        sys.path.insert(0, SHARED + '/lead-pipeline')
        from lead_pipeline import create_lead
        lead = create_lead(project, contact, intent)
        print(json.dumps({'ok': True, 'action': 'send', 'lead': lead}, ensure_ascii=False))
    else:
        print(json.dumps({'ok': True, 'action': 'list', 'leads': []}, ensure_ascii=False))

def cmd_status(args):
    print(json.dumps({'ok': True, 'service': 'octopus', 'status': 'online', 'slo': 'green', 'vectors': {'memory': 'green', 'self_sustain': 'green', 'live': 'yellow', 'simplify': 'green', 'coexist': 'green', 'reproduce': 'green', 'develop': 'green', 'learn': 'green', 'adapt': 'green'}}, ensure_ascii=False))

def cmd_search(args):
    query = args[0] if args else ''
    sys.path.insert(0, BASE + '/skills/memory/pwa-file-exchange')
    from memory_api import search_memory
    items = search_memory(query) if query else []
    print(json.dumps({'ok': True, 'action': 'search', 'query': query, 'items': items}, ensure_ascii=False))

def cmd_explain(args):
    sys.path.insert(0, '/mnt/agents/-Octopus/tools/explain')
    from main import get_status
    print(json.dumps(get_status(), ensure_ascii=False, indent=2))

def cmd_pause(args):
    services = ['octopus-lead-pipeline.service', 'octopus-webdav.service']
    results = []
    for svc in services:
        try:
            subprocess.run(['systemctl', 'stop', svc], check=True, timeout=5)
            results.append({'service': svc, 'action': 'stopped'})
        except Exception as e:
            results.append({'service': svc, 'action': 'error', 'error': str(e)})
    print(json.dumps({'ok': True, 'action': 'pause', 'results': results}, ensure_ascii=False))

def cmd_resume(args):
    services = ['octopus-lead-pipeline.service', 'octopus-webdav.service']
    results = []
    for svc in services:
        try:
            subprocess.run(['systemctl', 'start', svc], check=True, timeout=5)
            results.append({'service': svc, 'action': 'started'})
        except Exception as e:
            results.append({'service': svc, 'action': 'error', 'error': str(e)})
    print(json.dumps({'ok': True, 'action': 'resume', 'results': results}, ensure_ascii=False))

def main():
    if len(sys.argv) < 2:
        print('Usage: octopus <memory|lead|status|search|explain|pause|resume> [args]')
        sys.exit(1)
    cmd = sys.argv[1]
    args = sys.argv[2:]
    cmds = {
        'memory': cmd_memory, 'lead': cmd_lead, 'status': cmd_status,
        'search': cmd_search, 'explain': cmd_explain,
        'pause': cmd_pause, 'resume': cmd_resume
    }
    fn = cmds.get(cmd)
    if not fn:
        print(f'Unknown: {cmd}')
        sys.exit(1)
    fn(args)

if __name__ == '__main__':
    main()
