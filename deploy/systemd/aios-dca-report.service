[Unit]
Description=AIOS DCA portfolio weekly Telegram report
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/AIOS
Environment=PYTHONPATH=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python -u /root/AIOS/scripts/dca_telegram_report.py --weekly
ExecStart=/opt/aios/.venv/bin/python -u /root/AIOS/scripts/dca_chart_report.py --send

[Install]
WantedBy=multi-user.target
