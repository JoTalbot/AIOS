SERVICE_CATALOG=json.loads((CFG/'service_catalog.json').read_text())
LEADS=DATA/'income_sales_leads.jsonl'
class LeadReq(BaseModel):
    service_id:str
    contact:str=Field(min_length=3,max_length=200)
    requirements:str=Field(min_length=10,max_length=5000)
    budget_usd:float|None=Field(default=None,ge=0,le=100000)
    idempotency_key:str=Field(min_length=8,max_length=120)
    website:str=''  # honeypot

def _lead_count_today(ip_hash:str)->int:
    if not LEADS.exists(): return 0
    today=datetime.now(timezone.utc).date().isoformat(); n=0
    with LEADS.open() as f:
        for line in f:
            try:
                x=json.loads(line); n += int(str(x.get('created_at','')).startswith(today) and x.get('ip_hash')==ip_hash)
            except Exception: pass
    return n

def _existing_lead(key:str):
    if not LEADS.exists(): return None
    with LEADS.open() as f:
        for line in f:
            try:
                x=json.loads(line)
                if x.get('idempotency_key')==key:return x
            except Exception: pass
    return None

