def reconcile(marked):
    opens=sorted((x for x in marked if x['state']=='OPEN'),key=lambda x:x['number'])
    canonical=opens[0] if opens else (marked[0] if marked else None)
    duplicates=[x for x in marked if not canonical or x['number']!=canonical['number']]
    return canonical,duplicates,len(opens)<=1

def test_open_issue_is_canonical():
    c,d,h=reconcile([{'number':14,'state':'CLOSED'},{'number':12,'state':'OPEN'}])
    assert c['number']==12 and [x['number'] for x in d]==[14] and h

def test_multiple_open_marked_is_unhealthy():
    c,d,h=reconcile([{'number':12,'state':'OPEN'},{'number':15,'state':'OPEN'}])
    assert c['number']==12 and not h and len(d)==1

def test_empty_is_healthy_without_canonical():
    c,d,h=reconcile([]); assert c is None and d==[] and h
