[Unit]
Description=AIOS Orderbook WebSocket collector (Binance depth20@100ms, BTC/ETH/SOL)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/AIOS
Environment=PYTHONPATH=/root/AIOS
ExecStart=/opt/aios/.venv/bin/python -u /root/AIOS/scripts/collect_orderbook_ws.py --pairs BTC ETH SOL XRP BNB DOGE ADA --interval 1.0 --db /root/AIOS/data/quant/orderbooks.sqlite
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
