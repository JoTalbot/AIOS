{
  "dashboard": {
    "id": null,
    "uid": "octopus-swarm-v1",
    "title": "🐙 Octopus Swarm — Live",
    "tags": ["octopus", "swarm", "registry"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "15s",
    "time": {"from": "now-1h", "to": "now"},
    "panels": [
      {
        "id": 1,
        "type": "stat",
        "title": "Нод онлайн",
        "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
        "targets": [
          {"expr": "octopus_swarm_online", "refId": "A", "datasource": {"type": "prometheus", "uid": "cfmbovwjwe5mod"}}
        ],
        "options": {
          "reduceOptions": {"calcs": ["lastNotNull"]},
          "colorMode": "background",
          "graphMode": "none"
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": null},
                {"color": "orange", "value": 1},
                {"color": "green", "value": 3}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "type": "stat",
        "title": "Всего в registry",
        "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
        "targets": [
          {"expr": "octopus_registry_total", "refId": "A", "datasource": {"type": "prometheus", "uid": "cfmbovwjwe5mod"}}
        ],
        "options": {
          "reduceOptions": {"calcs": ["lastNotNull"]},
          "colorMode": "background",
          "graphMode": "none"
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "fixed", "fixedColor": "blue"}
          }
        }
      },
      {
        "id": 3,
        "type": "stat",
        "title": "В карантине",
        "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
        "targets": [
          {"expr": "sum(octopus_node_quarantined)", "refId": "A", "datasource": {"type": "prometheus", "uid": "cfmbovwjwe5mod"}}
        ],
        "options": {
          "reduceOptions": {"calcs": ["lastNotNull"]},
          "colorMode": "background",
          "graphMode": "none"
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "orange", "value": 1}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "type": "stat",
        "title": "Сумма peers",
        "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
        "targets": [
          {"expr": "sum(octopus_node_peers)", "refId": "A", "datasource": {"type": "prometheus", "uid": "cfmbovwjwe5mod"}}
        ],
        "options": {
          "reduceOptions": {"calcs": ["lastNotNull"]},
          "colorMode": "background",
          "graphMode": "none"
        },
        "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "purple"}}}
      },
      {
        "id": 5,
        "type": "timeseries",
        "title": "Статус нод (1=online,2=degraded,3=quarantined,0=offline)",
        "gridPos": {"x": 0, "y": 4, "w": 12, "h": 9},
        "targets": [
          {"expr": "octopus_node_status", "refId": "A", "legendFormat": "{{label}}", "datasource": {"type": "prometheus", "uid": "cfmbovwjwe5mod"}}
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {"drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 20, "spanNulls": true},
            "color": {"mode": "palette-classic"},
            "min": 0, "max": 3
          }
        }
      },
      {
        "id": 6,
        "type": "timeseries",
        "title": "Peers по нодам",
        "gridPos": {"x": 12, "y": 4, "w": 12, "h": 9},
        "targets": [
          {"expr": "octopus_node_peers", "refId": "A", "legendFormat": "{{label}}", "datasource": {"type": "prometheus", "uid": "cfmbovwjwe5mod"}}
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10},
            "color": {"mode": "palette-classic"},
            "min": 0
          }
        }
      },
      {
        "id": 7,
        "type": "table",
        "title": "Snapshot роя",
        "gridPos": {"x": 0, "y": 13, "w": 24, "h": 8},
        "targets": [
          {"expr": "octopus_node_status", "refId": "A", "format": "table", "instant": true, "datasource": {"type": "prometheus", "uid": "cfmbovwjwe5mod"}},
          {"expr": "octopus_node_peers", "refId": "B", "format": "table", "instant": true, "datasource": {"type": "prometheus", "uid": "cfmbovwjwe5mod"}},
          {"expr": "octopus_node_uptime_seconds", "refId": "C", "format": "table", "instant": true, "datasource": {"type": "prometheus", "uid": "cfmbovwjwe5mod"}}
        ],
        "transformations": [
          {"id": "merge", "options": {}},
          {"id": "organize", "options": {
            "excludeByName": {"Time": true, "__name__": true, "job": true, "instance": true, "project": true, "source": true, "host": true, "port": true},
            "renameByName": {
              "label": "Нода",
              "id": "ID",
              "role": "Роль",
              "external": "Внешняя",
              "Value #A": "Status",
              "Value #B": "Peers",
              "Value #C": "Uptime (s)"
            }
          }}
        ]
      },
      {
        "id": 8,
        "type": "timeseries",
        "title": "Uptime по нодам (часы)",
        "gridPos": {"x": 0, "y": 21, "w": 24, "h": 8},
        "targets": [
          {"expr": "octopus_node_uptime_seconds / 3600", "refId": "A", "legendFormat": "{{label}}", "datasource": {"type": "prometheus", "uid": "cfmbovwjwe5mod"}}
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {"drawStyle": "line", "fillOpacity": 5},
            "color": {"mode": "palette-classic"},
            "unit": "h"
          }
        }
      }
    ]
  },
  "overwrite": true,
  "folderUid": "",
  "message": "Provisioned by Octopus agent (registry-aware metrics)"
}
