[Unit]
Description=AIOS OpenAI-compatible LLM proxy (Colab->llm_balancer) for Kilo
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/aios/.venv/bin/python /root/AIOS/scripts/llm_balancer_openai_proxy.py
Environment=AIOS_PROXY_PORT=8099
Restart=on-failure
RestartSec=5
User=root
WorkingDirectory=/root/AIOS

[Install]
WantedBy=multi-user.target
