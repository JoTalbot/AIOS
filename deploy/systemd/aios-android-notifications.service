[Unit]
Description=AIOS selected Android app notification collector
After=aios-android-gateway.service
Requires=aios-android-gateway.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/AIOS
Environment=AIOS_ADB_BIN=/usr/local/bin/aios-adb
ExecStart=/opt/aios/.venv/bin/python /root/AIOS/run_android_notification_collector.py collect
StandardOutput=append:/root/AIOS/logs/android_notifications.log
StandardError=append:/root/AIOS/logs/android_notifications.log
