[Unit]
Description=AIOS DCA portfolio CONTROL (plain DCA, A/B vs VA main)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/AIOS
Environment=PYTHONPATH=/root/AIOS
Environment=DCA_CONFIG=dca_portfolio_control
ExecStart=/opt/aios/.venv/bin/python -u /root/AIOS/scripts/run_dca_paper.py

[Install]
WantedBy=multi-user.target
