[Unit]
Description=AIOS Colab/Qwen and Telegram outbox canary
After=network-online.target aios-telegram-bot.service aios-tg.service aios-colab-keeper.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/AIOS
EnvironmentFile=-/root/AIOS/.env
EnvironmentFile=-/etc/aios/telegram-canary.env
LoadCredential=telegram_token:/etc/aios/credentials/telegram_token
LoadCredential=telegram_owner_chat_id:/etc/aios/credentials/telegram_owner_chat_id
LoadCredential=telegram_queue_key:/etc/aios/credentials/telegram_queue_key
Environment=AIOS_TELEGRAM_STATE_DIR=/var/lib/aios/telegram
Environment=AIOS_TELEGRAM_LOG_DIR=/var/log/aios/telegram
Environment=AIOS_COLAB_MODE_FILE=/etc/aios/colab-mode
Environment=CANARY_SEND_TELEGRAM=1
ExecStart=/opt/aios/.venv/bin/python /root/AIOS/scripts/telegram_colab_canary.py
StandardOutput=append:/var/log/aios/telegram/telegram_colab_canary.log
StandardError=append:/var/log/aios/telegram/telegram_colab_canary.log
TimeoutStartSec=180
UMask=0077
Nice=10
